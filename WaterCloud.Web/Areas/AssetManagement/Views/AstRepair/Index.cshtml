@{
    ViewBag.Title = "公物报修";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'table', 'common', 'commonTable'], function () {
        var $ = layui.jquery, form = layui.form, table = layui.table, common = layui.common, commonTable = layui.commonTable;
        currentTableBar.innerHTML = common.authorizeButtonNew(currentTableBar.innerHTML);
        toolbarDemo.innerHTML = common.authorizeButtonNew(toolbarDemo.innerHTML);
        wcLoading.close();

        commonTable.rendertable({
            elem: '#currentTableId', id: 'currentTableId', url: '/AssetManagement/AstRepair/GetGridJson',
            cols: [[
                { type: 'checkbox', fixed: 'left' },
                { field: 'F_ReporterName', title: '报修人', width: 100 },
                { field: 'F_AssetId', title: '资产ID', width: 180 },
                { field: 'F_ReportTime', title: '报修时间', width: 160 },
                { field: 'F_FaultDescription', title: '故障描述', width: 200 },
                { field: 'F_Status', title: '状态', width: 90, align: 'center' },
                { field: 'F_RepairCost', title: '维修费', width: 90, align: 'right' },
                { title: '操作', width: 180, toolbar: '#currentTableBar', align: 'center', fixed: 'right' }
            ]]
        });

        form.on('submit(data-search-btn)', function () { commonTable.reloadtable({ elem: 'currentTableId', curr: 1, where: { keyword: $('#txt_keyword').val(), status: $('#F_Status').val() } }); return false; });

        table.on('toolbar(currentTableFilter)', function (obj) {
            if (obj.event === 'add') { common.modalOpen({ title: '公物报修', url: '/AssetManagement/AstRepair/Form', width: '600px', height: '75%' }); }
        });

        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            if (obj.event === 'accept') {
                layer.prompt({ title: '维修人', formType: 0 }, function (val, idx) {
                    layer.close(idx);
                    common.submitForm({ url: '/AssetManagement/AstRepair/AcceptRepair', param: { keyValue: data.F_Id, repairer: val }, success: function () { commonTable.reloadtable({ elem: 'currentTableId' }); } });
                });
            } else if (obj.event === 'finish') {
                layer.prompt({ title: '维修费用', formType: 0 }, function (cost, idx) {
                    layer.close(idx);
                    layer.prompt({ title: '更换配件', formType: 0 }, function (parts, idx2) {
                        layer.close(idx2);
                        layer.prompt({ title: '维修结果', formType: 2 }, function (result, idx3) {
                            layer.close(idx3);
                            common.submitForm({ url: '/AssetManagement/AstRepair/FinishRepair', param: { keyValue: data.F_Id, cost: cost, parts: parts, result: result }, success: function () { commonTable.reloadtable({ elem: 'currentTableId' }); } });
                        });
                    });
                });
            }
        });
    });
</script>
<div class="layuimini-container"><div class="layuimini-main">
    <fieldset class="table-search-fieldset"><legend>搜索信息</legend><div style="margin:10px"><form class="layui-form layui-form-pane"><div class="layui-form-item">
        <div class="layui-inline"><label class="layui-form-label">关键字:</label><div class="layui-input-inline"><input type="text" id="txt_keyword" autocomplete="off" class="layui-input"></div></div>
        <div class="layui-inline"><label class="layui-form-label">状态:</label><div class="layui-input-inline"><select id="F_Status"><option value="">全部</option><option value="待受理">待受理</option><option value="维修中">维修中</option><option value="已完成">已完成</option><option value="已驳回">已驳回</option></select></div></div>
        <div class="layui-inline"><button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button></div>
    </div></form></div></fieldset>
    <script type="text/html" id="toolbarDemo"><div class="layui-btn-container">
        <button class="layui-btn layui-btn-sm layui-btn-normal" lay-event="add" id="NF-add" name="NF-add" authorize><i class="layui-icon">&#xe654;</i>报修</button>
    </div></script>
    <script type="text/html" id="currentTableBar">
        <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="accept" id="NF-edit" authorize>受理</a>
        <a class="layui-btn layui-btn-xs" lay-event="finish" id="NF-approve" authorize>完工</a>
    </script>
    <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
</div></div>
