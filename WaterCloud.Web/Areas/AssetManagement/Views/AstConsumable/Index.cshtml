@{
    ViewBag.Title = "低值易耗品";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'table', 'common', 'commonTable'], function () {
        var $ = layui.jquery, form = layui.form, table = layui.table, common = layui.common, commonTable = layui.commonTable;
        currentTableBar.innerHTML = common.authorizeButtonNew(currentTableBar.innerHTML);
        toolbarDemo.innerHTML = common.authorizeButtonNew(toolbarDemo.innerHTML);
        wcLoading.close();

        commonTable.rendertable({
            elem: '#currentTableId', id: 'currentTableId', url: '/AssetManagement/AstConsumable/GetGridJson',
            cols: [[
                { type: 'checkbox', fixed: 'left' },
                { field: 'F_Name', title: '名称', width: 160 },
                { field: 'F_Spec', title: '规格', width: 120 },
                { field: 'F_Unit', title: '单位', width: 80, align: 'center' },
                { field: 'F_StockQty', title: '库存', width: 90, align: 'right', templet: function (d) { return (d.F_StockQty <= (d.F_StockWarnQty || 0)) ? '<span style="color:red">' + d.F_StockQty + '</span>' : d.F_StockQty; } },
                { field: 'F_StockWarnQty', title: '预警值', width: 90, align: 'right' },
                { field: 'F_UnitPrice', title: '单价', width: 90, align: 'right' },
                { title: '操作', width: 180, toolbar: '#currentTableBar', align: 'center', fixed: 'right' }
            ]]
        });

        form.on('submit(data-search-btn)', function () { commonTable.reloadtable({ elem: 'currentTableId', curr: 1, where: { keyword: $('#txt_keyword').val() } }); return false; });

        var oneList = ["NF-edit"]; var moreList = ["NF-delete"];
        commonTable.tableRowClick("checkbox", "currentTableFilter", "currentTableId", oneList, moreList);

        table.on('toolbar(currentTableFilter)', function (obj) {
            var checkStatus = table.checkStatus('currentTableId');
            if (obj.event === 'add') { common.modalOpen({ title: '新增耗材', url: '/AssetManagement/AstConsumable/Form', width: '600px', height: '75%' }); }
            else if (obj.event === 'delete') {
                if (checkStatus.data.length == 0) { common.modalMsg('请选择需要删除的数据', 'warning'); return false; }
                var ids = checkStatus.data.map(function (d) { return d.F_Id; });
                common.deleteForm({ url: '/AssetManagement/AstConsumable/DeleteForm', param: { keyValue: ids.join(',') }, success: function () { commonTable.reloadtable({ elem: 'currentTableId' }); } });
            }
        });

        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            if (obj.event === 'edit') { common.modalOpen({ title: '编辑耗材', url: '/AssetManagement/AstConsumable/Form?keyValue=' + data.F_Id, width: '600px', height: '75%' }); }
            else if (obj.event === 'delete') { common.deleteForm({ url: '/AssetManagement/AstConsumable/DeleteForm', param: { keyValue: data.F_Id }, success: function () { commonTable.reloadtable({ elem: 'currentTableId' }); } }); }
            else if (obj.event === 'in') {
                layer.prompt({ title: '入库数量', formType: 0 }, function (qty, idx) {
                    layer.close(idx);
                    common.submitForm({ url: '/AssetManagement/AstConsumable/OperateStock', param: { F_ConsumableId: data.F_Id, F_OperateType: '入库', F_Qty: qty }, success: function () { commonTable.reloadtable({ elem: 'currentTableId' }); } });
                });
            } else if (obj.event === 'out') {
                layer.prompt({ title: '领用数量', formType: 0 }, function (qty, idx) {
                    layer.close(idx);
                    common.submitForm({ url: '/AssetManagement/AstConsumable/OperateStock', param: { F_ConsumableId: data.F_Id, F_OperateType: '领用', F_Qty: qty }, success: function () { commonTable.reloadtable({ elem: 'currentTableId' }); } });
                });
            }
        });
    });
</script>
<div class="layuimini-container"><div class="layuimini-main">
    <fieldset class="table-search-fieldset"><legend>搜索信息</legend><div style="margin:10px"><form class="layui-form layui-form-pane"><div class="layui-form-item">
        <div class="layui-inline"><label class="layui-form-label">关键字:</label><div class="layui-input-inline"><input type="text" id="txt_keyword" autocomplete="off" class="layui-input" placeholder="名称/规格"></div></div>
        <div class="layui-inline"><button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button></div>
    </div></form></div></fieldset>
    <script type="text/html" id="toolbarDemo"><div class="layui-btn-container">
        <button class="layui-btn layui-btn-sm layui-btn-normal" lay-event="add" id="NF-add" name="NF-add" authorize><i class="layui-icon">&#xe654;</i>新增</button>
        <button class="layui-btn layui-btn-sm layui-btn-danger" lay-event="delete" id="NF-delete" name="NF-delete" authorize><i class="layui-icon">&#xe640;</i>删除</button>
    </div></script>
    <script type="text/html" id="currentTableBar">
        <a class="layui-btn layui-btn-xs" lay-event="edit" id="NF-edit" authorize><i class="layui-icon">&#xe642;</i>编辑</a>
        <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="in" id="NF-edit" authorize>入库</a>
        <a class="layui-btn layui-btn-xs layui-btn-warm" lay-event="out" id="NF-edit" authorize>领用</a>
        <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="delete" id="NF-delete" authorize><i class="layui-icon">&#xe640;</i>删除</a>
    </script>
    <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
</div></div>
