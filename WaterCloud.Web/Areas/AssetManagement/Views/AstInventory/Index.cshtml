@{
    ViewBag.Title = "学期盘点";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'table', 'common', 'commonTable'], function () {
        var $ = layui.jquery, form = layui.form, table = layui.table, common = layui.common, commonTable = layui.commonTable;
        currentTableBar.innerHTML = common.authorizeButtonNew(currentTableBar.innerHTML);
        toolbarDemo.innerHTML = common.authorizeButtonNew(toolbarDemo.innerHTML);
        wcLoading.close();

        commonTable.rendertable({
            elem: '#currentTableId', id: 'currentTableId', url: '/AssetManagement/AstInventory/GetGridJson',
            cols: [[
                { type: 'checkbox', fixed: 'left' },
                { field: 'F_Term', title: '学期', width: 140 },
                { field: 'F_InventoryType', title: '类型', width: 100, align: 'center' },
                { field: 'F_Status', title: '状态', width: 100, align: 'center' },
                { field: 'F_CreateTime', title: '创建时间', width: 160 },
                { field: 'F_FinishTime', title: '完成时间', width: 160 },
                { title: '操作', width: 200, toolbar: '#currentTableBar', align: 'center', fixed: 'right' }
            ]]
        });

        form.on('submit(data-search-btn)', function () { commonTable.reloadtable({ elem: 'currentTableId', curr: 1, where: { keyword: $('#txt_keyword').val() } }); return false; });

        table.on('toolbar(currentTableFilter)', function (obj) {
            if (obj.event === 'add') { common.modalOpen({ title: '新建盘点', url: '/AssetManagement/AstInventory/Form', width: '600px', height: '70%' }); }
        });

        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            if (obj.event === 'detail') { common.modalOpen({ title: '盘点明细', url: '/AssetManagement/AstInventory/Detail?inventoryId=' + data.F_Id, width: '1000px', height: '90%' }); }
            else if (obj.event === 'generate') {
                layer.prompt({ title: '生成盘点明细（年级ID，留空全部）', formType: 0 }, function (gradeId, idx) {
                    layer.close(idx);
                    layer.prompt({ title: '班级ID（留空全部）', formType: 0 }, function (classId, idx2) {
                        layer.close(idx2);
                        common.submitForm({ url: '/AssetManagement/AstInventory/GenerateItems', param: { inventoryId: data.F_Id, gradeId: gradeId, classId: classId }, success: function () { commonTable.reloadtable({ elem: 'currentTableId' }); } });
                    });
                });
            } else if (obj.event === 'finish') {
                common.submitForm({ url: '/AssetManagement/AstInventory/FinishInventory', param: { inventoryId: data.F_Id }, success: function () { commonTable.reloadtable({ elem: 'currentTableId' }); } });
            }
        });
    });
</script>
<div class="layuimini-container"><div class="layuimini-main">
    <fieldset class="table-search-fieldset"><legend>搜索信息</legend><div style="margin:10px"><form class="layui-form layui-form-pane"><div class="layui-form-item">
        <div class="layui-inline"><label class="layui-form-label">关键字:</label><div class="layui-input-inline"><input type="text" id="txt_keyword" autocomplete="off" class="layui-input" placeholder="学期"></div></div>
        <div class="layui-inline"><button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button></div>
    </div></form></div></fieldset>
    <script type="text/html" id="toolbarDemo"><div class="layui-btn-container">
        <button class="layui-btn layui-btn-sm layui-btn-normal" lay-event="add" id="NF-add" name="NF-add" authorize><i class="layui-icon">&#xe654;</i>新建盘点</button>
    </div></script>
    <script type="text/html" id="currentTableBar">
        <a class="layui-btn layui-btn-xs" lay-event="generate" id="NF-edit" authorize>生成明细</a>
        <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="detail" id="NF-details" authorize>明细</a>
        <a class="layui-btn layui-btn-xs layui-btn-warm" lay-event="finish" id="NF-approve" authorize>完成</a>
    </script>
    <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
</div></div>
