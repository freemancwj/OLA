@{
    ViewBag.Title = "资产卡片";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'table', 'common', 'commonTable', 'optimizeSelectOption'], function () {
        var $ = layui.jquery, form = layui.form, table = layui.table, common = layui.common, commonTable = layui.commonTable;
        currentTableBar.innerHTML = common.authorizeButtonNew(currentTableBar.innerHTML);
        toolbarDemo.innerHTML = common.authorizeButtonNew(toolbarDemo.innerHTML);
        wcLoading.close();
        $('#F_CategoryId').bindSelect({ url: '/AssetManagement/AstCategory/GetGridJson', id: 'F_Id', text: 'F_CategoryName', search: true });

        commonTable.rendertable({
            elem: '#currentTableId', id: 'currentTableId', url: '/AssetManagement/AstAsset/GetGridJson',
            cols: [[
                { type: 'checkbox', fixed: 'left' },
                { field: 'F_AssetCode', title: '资产编号', width: 130 },
                { field: 'F_AssetName', title: '资产名称', width: 160 },
                { field: 'F_SpecModel', title: '规格型号', width: 140 },
                { field: 'F_PurchasePrice', title: '原值', width: 100, align: 'right' },
                { field: 'F_NetValue', title: '净值', width: 100, align: 'right' },
                { field: 'F_Status', title: '状态', width: 90, align: 'center' },
                { field: 'F_DamageCount', title: '损坏次数', width: 90, align: 'center' },
                { field: 'F_Location', title: '存放位置', width: 140 },
                { title: '操作', width: 130, toolbar: '#currentTableBar', align: 'center', fixed: 'right' }
            ]]
        });

        form.on('submit(data-search-btn)', function () {
            commonTable.reloadtable({ elem: 'currentTableId', curr: 1, where: { keyword: $('#txt_keyword').val(), categoryId: $('#F_CategoryId').val(), status: $('#F_Status').val() } });
            return false;
        });

        var oneList = ["NF-edit"]; var moreList = ["NF-delete"];
        commonTable.tableRowClick("checkbox", "currentTableFilter", "currentTableId", oneList, moreList);

        table.on('toolbar(currentTableFilter)', function (obj) {
            var checkStatus = table.checkStatus('currentTableId');
            if (obj.event === 'add') { common.modalOpen({ title: '新增资产', url: '/AssetManagement/AstAsset/Form', width: '900px', height: '92%' }); }
            else if (obj.event === 'delete') {
                if (checkStatus.data.length == 0) { common.modalMsg('请选择需要删除的数据', 'warning'); return false; }
                var ids = checkStatus.data.map(function (d) { return d.F_Id; });
                common.deleteForm({ url: '/AssetManagement/AstAsset/DeleteForm', param: { keyValue: ids.join(',') }, success: function () { commonTable.reloadtable({ elem: 'currentTableId' }); } });
            }
        });

        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            if (obj.event === 'edit') { common.modalOpen({ title: '编辑资产', url: '/AssetManagement/AstAsset/Form?keyValue=' + data.F_Id, width: '900px', height: '92%' }); }
            else if (obj.event === 'delete') { common.deleteForm({ url: '/AssetManagement/AstAsset/DeleteForm', param: { keyValue: data.F_Id }, success: function () { commonTable.reloadtable({ elem: 'currentTableId' }); } }); }
        });
    });
</script>
<div class="layuimini-container"><div class="layuimini-main">
    <fieldset class="table-search-fieldset"><legend>搜索信息</legend><div style="margin:10px"><form class="layui-form layui-form-pane"><div class="layui-form-item">
        <div class="layui-inline"><label class="layui-form-label">关键字:</label><div class="layui-input-inline"><input type="text" id="txt_keyword" autocomplete="off" class="layui-input" placeholder="编号/名称/序列号"></div></div>
        <div class="layui-inline"><label class="layui-form-label">分类:</label><div class="layui-input-inline"><select id="F_CategoryId" name="F_CategoryId" lay-search><option value="">全部</option></select></div></div>
        <div class="layui-inline"><label class="layui-form-label">状态:</label><div class="layui-input-inline"><select id="F_Status" name="F_Status"><option value="">全部</option><option value="在用">在用</option><option value="闲置">闲置</option><option value="维修中">维修中</option><option value="借用中">借用中</option><option value="报废">报废</option></select></div></div>
        <div class="layui-inline"><button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button></div>
    </div></form></div></fieldset>
    <script type="text/html" id="toolbarDemo"><div class="layui-btn-container">
        <button class="layui-btn layui-btn-sm layui-btn-normal" lay-event="add" id="NF-add" name="NF-add" authorize><i class="layui-icon">&#xe654;</i>新增资产</button>
        <button class="layui-btn layui-btn-sm layui-btn-danger" lay-event="delete" id="NF-delete" name="NF-delete" authorize><i class="layui-icon">&#xe640;</i>删除</button>
    </div></script>
    <script type="text/html" id="currentTableBar">
        <a class="layui-btn layui-btn-xs" lay-event="edit" id="NF-edit" authorize><i class="layui-icon">&#xe642;</i>编辑</a>
        <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="delete" id="NF-delete" authorize><i class="layui-icon">&#xe640;</i>删除</a>
    </script>
    <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
</div></div>
