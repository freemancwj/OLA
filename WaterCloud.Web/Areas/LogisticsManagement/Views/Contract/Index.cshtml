@{
    ViewBag.Title = "合同管理";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'table', 'common', 'commonTable', 'optimizeSelectOption'], function () {
        var $ = layui.jquery,
            form = layui.form,
            table = layui.table,
            common = layui.common,
            commonTable = layui.commonTable;

        wcLoading.close();

        commonTable.rendertable({
            elem: '#currentTableId',
            id: 'currentTableId',
            url: '/LogisticsManagement/Contract/GetGridJson',
            cols: [[
                { type: 'checkbox', fixed: 'left' },
                { field: 'F_ContractNo', title: '合同编号', width: 140, sort: true },
                { field: 'F_Name', title: '合同名称', minWidth: 180, sort: true },
                { field: 'F_PartyA', title: '甲方', width: 160 },
                { field: 'F_PartyB', title: '乙方', width: 160 },
                { field: 'F_Amount', title: '金额(元)', width: 120, templet: function (d) { return d.F_Amount == null ? '' : d.F_Amount; } },
                { field: 'F_SignDate', title: '签订日期', width: 110, templet: function (d) { return d.F_SignDate ? String(d.F_SignDate).substring(0, 10) : ''; } },
                { field: 'F_ExpireDate', title: '到期日期', width: 110, templet: function (d) { return d.F_ExpireDate ? String(d.F_ExpireDate).substring(0, 10) : ''; } },
                {
                    field: 'F_Status', title: '状态', width: 90, templet: function (d) {
                        if (d.F_Status == 1) return '<span class="layui-badge layui-bg-blue">已到期</span>';
                        if (d.F_Status == 2) return '<span class="layui-badge layui-bg-red">已终止</span>';
                        return '<span class="layui-badge layui-bg-green">履行中</span>';
                    }
                },
                {
                    field: 'F_FileName', title: '附件', width: 90, templet: function (d) {
                        return d.F_FileUrl ? '<a href="' + d.F_FileUrl + '" target="_blank" style="color:#1E9FFF">查看</a>' : '';
                    }
                },
                { title: '操作', width: 120, toolbar: '#currentTableBar', fixed: 'right' }
            ]]
        });

        currentTableBar.innerHTML = common.authorizeButtonNew(currentTableBar.innerHTML);
        toolbarDemo.innerHTML = common.authorizeButtonNew(toolbarDemo.innerHTML);

        //监听搜索
        form.on('submit(data-search-btn)', function (data) {
            commonTable.reloadtable({
                elem: 'currentTableId',
                curr: 1,
                where: { keyword: $('#txt_keyword').val(), status: $('#F_Status').val() }
            });
            return false;
        });

        //工具条事件
        commonTable.tableRowClick({
            tableId: 'currentTableId',
            edit: function (data) {
                common.modalOpen({
                    title: '修改合同',
                    url: '/LogisticsManagement/Contract/Form?keyValue=' + data.F_Id,
                    width: '600px',
                    height: '680px'
                });
            },
            del: function (data) {
                common.deleteForm({
                    url: '/LogisticsManagement/Contract/DeleteForm',
                    param: { keyValue: data.F_Id },
                    success: function () {
                        commonTable.reloadtable({ elem: 'currentTableId' });
                    }
                });
            }
        });

        //工具栏事件
        table.on('toolbar(currentTableId)', function (obj) {
            var checkStatus = table.checkStatus('currentTableId');
            if (obj.event === 'add') {
                common.modalOpen({
                    title: '新增合同',
                    url: '/LogisticsManagement/Contract/Form',
                    width: '600px',
                    height: '680px'
                });
            }
            else if (obj.event === 'delete') {
                if (checkStatus.data.length == 0) {
                    common.modalMsg('请选择需要删除的数据', 'warning');
                    return false;
                }
                var ids = [];
                for (var i = 0; i < checkStatus.data.length; i++) {
                    ids.push(checkStatus.data[i].F_Id);
                }
                common.deleteForm({
                    url: '/LogisticsManagement/Contract/DeleteForm',
                    param: { keyValue: ids.join(',') },
                    success: function () {
                        commonTable.reloadtable({ elem: 'currentTableId' });
                    }
                });
            }
        });
    });
</script>

<div class="layuimini-container">
    <div class="layuimini-main">
        <fieldset class="table-search-fieldset">
            <legend>搜索信息</legend>
            <div style="margin: 10px 10px 10px 10px">
                <form class="layui-form layui-form-pane">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">关键字:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="txt_keyword" name="txt_keyword" autocomplete="off" class="layui-input" placeholder="编号/名称/甲方/乙方">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">状态:</label>
                            <div class="layui-input-inline" style="width:130px;">
                                <select id="F_Status" name="F_Status">
                                    <option value="">全部</option>
                                    <option value="0">履行中</option>
                                    <option value="1">已到期</option>
                                    <option value="2">已终止</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>
        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container">
                <button class="layui-btn layui-btn-sm" lay-event="add" id="NF-add" authorize><i class="layui-icon">&#xe654;</i>新增</button>
                <button class="layui-btn layui-btn-sm layui-btn-danger" lay-event="delete" id="NF-delete" authorize><i class="layui-icon">&#xe640;</i>删除</button>
            </div>
        </script>
        <script type="text/html" id="currentTableBar">
            <a class="layui-btn layui-btn-xs" lay-event="edit" id="NF-edit" authorize><i class="layui-icon">&#xe642;</i>修改</a>
        </script>
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableId"></table>
    </div>
</div>
