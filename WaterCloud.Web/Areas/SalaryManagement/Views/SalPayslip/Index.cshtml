@{
    ViewBag.Title = "工资单管理";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'table', 'laydate', 'common', 'commonTable', 'optimizeSelectOption'], function () {
        var $ = layui.jquery,
            form = layui.form,
            table = layui.table,
            laydate = layui.laydate,
            common = layui.common,
            commonTable = layui.commonTable;

        //权限控制(js是值传递)
        currentTableBar.innerHTML = common.authorizeButtonNew(currentTableBar.innerHTML);
        toolbarDemo.innerHTML = common.authorizeButtonNew(toolbarDemo.innerHTML);
        wcLoading.close();

        laydate.render({ elem: '#F_Month', type: 'month' });

        //状态徽标
        var statusMap = {
            0: ['草稿', 'layui-bg-gray'],
            1: ['人事已提交', 'layui-bg-blue'],
            2: ['教务已核对', 'layui-bg-cyan'],
            3: ['财务已核对', 'layui-bg-green'],
            4: ['已归档锁定', 'layui-bg-black'],
            5: ['已驳回', 'layui-bg-red']
        };

        //带防伪token的操作类POST请求
        function postAction(url, param, success) {
            var csrfToken = '';
            if ($('[name=__RequestVerificationToken]').length > 0) {
                csrfToken = $('[name=__RequestVerificationToken]').val();
            }
            var index = parent.layer.load(0, { shade: [0.5, '#000'] });
            $.ajax({
                url: common.urlAddTime(url),
                data: param,
                type: 'post',
                dataType: 'json',
                headers: { "X-CSRF-TOKEN": csrfToken },
                success: function (data) {
                    if (data.state == "success") {
                        common.modalMsg(data.message, data.state);
                        if (!!success) success(data);
                    } else {
                        common.modalAlert(data.message, data.state);
                    }
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    common.modalAlert(errorThrown, "error");
                },
                complete: function () {
                    parent.layer.close(index);
                }
            });
        }

        commonTable.rendertable({
            elem: '#currentTableId',
            id: 'currentTableId',
            url: '/SalaryManagement/SalPayslip/GetGridJson',
            cols: [[
                { field: 'F_Month', title: '月份', width: 90, align: 'center', fixed: 'left' },
                { field: 'F_Account', title: '账号', width: 100 },
                { field: 'F_RealName', title: '姓名', width: 100 },
                { field: 'F_FixedTotal', title: '固定部分', width: 100, align: 'right' },
                { field: 'F_PeriodTotal', title: '课时费', width: 100, align: 'right' },
                { field: 'F_HeadTeacherTotal', title: '班主任津贴', width: 110, align: 'right' },
                { field: 'F_AfterSchoolTotal', title: '课后服务费', width: 110, align: 'right' },
                { field: 'F_SpecialTotal', title: '专项津贴', width: 100, align: 'right' },
                { field: 'F_AttendanceDeduct', title: '考勤扣款', width: 100, align: 'right' },
                { field: 'F_SocialPersonal', title: '社保公积金', width: 110, align: 'right' },
                { field: 'F_Tax', title: '个税', width: 90, align: 'right' },
                { field: 'F_GrossPay', title: '应发', width: 100, align: 'right' },
                { field: 'F_NetPay', title: '实发', width: 100, align: 'right' },
                {
                    field: 'F_Status', title: '状态', width: 110, align: 'center',
                    templet: function (d) {
                        var s = statusMap[d.F_Status] || statusMap[0];
                        return '<span class="layui-badge ' + s[1] + '">' + s[0] + '</span>';
                    }
                },
                { title: '操作', width: 260, toolbar: '#currentTableBar', align: 'center', fixed: 'right' }
            ]]
        });

        form.on('submit(data-search-btn)', function (data) {
            commonTable.reloadtable({
                elem: 'currentTableId',
                curr: 1,
                where: {
                    month: $('#F_Month').val(),
                    keyword: $('#txt_keyword').val(),
                    status: $('#status').val()
                }
            });
            return false;
        });

        table.on('toolbar(currentTableFilter)', function (obj) {
            if (obj.event === 'calc') {
                var month = $('#F_Month').val();
                if (!month) {
                    common.modalMsg('请先在搜索区选择月份', 'warning');
                    return false;
                }
                common.modalConfirm('确认对 ' + month + ' 执行月度算薪吗？已存在的草稿工资单将被重新计算。', function (r) {
                    if (r) {
                        postAction('/SalaryManagement/SalPayslip/CalculateMonth', { month: month }, function () {
                            commonTable.reloadtable({ elem: 'currentTableId' });
                        });
                    }
                });
            }
        });

        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            if (obj.event === 'details') {
                common.modalOpen({
                    title: '工资明细',
                    url: '/SalaryManagement/SalPayslip/Details?keyValue=' + data.F_Id,
                    width: '900px',
                    height: '90%',
                    btn: []
                });
            }
            else if (obj.event === 'submit') {
                common.modalConfirm('确认提交该工资单进入审批流程吗？', function (r) {
                    if (r) {
                        postAction('/SalaryManagement/SalPayslip/SubmitApprove', { keyValue: data.F_Id }, function () {
                            commonTable.reloadtable({ elem: 'currentTableId' });
                        });
                    }
                });
            }
            else if (obj.event === 'approve') {
                layer.prompt({ formType: 2, title: '请输入审批意见', value: '同意' }, function (value, index) {
                    layer.close(index);
                    postAction('/SalaryManagement/SalPayslip/Approve', { keyValue: data.F_Id, remark: value }, function () {
                        commonTable.reloadtable({ elem: 'currentTableId' });
                    });
                });
            }
            else if (obj.event === 'reject') {
                layer.prompt({ formType: 2, title: '请输入驳回原因' }, function (value, index) {
                    layer.close(index);
                    postAction('/SalaryManagement/SalPayslip/Reject', { keyValue: data.F_Id, remark: value }, function () {
                        commonTable.reloadtable({ elem: 'currentTableId' });
                    });
                });
            }
        });
    });
</script>

<div class="layuimini-container">
    <div class="layuimini-main">
        <fieldset class="table-search-fieldset">
            <legend>搜索信息</legend>
            <div style="margin: 10px 10px 10px 10px">
                <form class="layui-form layui-form-pane">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">月份:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="F_Month" name="F_Month" autocomplete="off" class="layui-input" placeholder="yyyy-MM">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">关键字:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="txt_keyword" name="txt_keyword" autocomplete="off" class="layui-input" placeholder="账号/姓名">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">状态:</label>
                            <div class="layui-input-inline">
                                <select id="status" name="status">
                                    <option value="">全部</option>
                                    <option value="0">草稿</option>
                                    <option value="1">人事已提交</option>
                                    <option value="2">教务已核对</option>
                                    <option value="3">财务已核对</option>
                                    <option value="4">已归档锁定</option>
                                    <option value="5">已驳回</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>
        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container">
                <button class="layui-btn layui-btn-sm layui-btn-normal" lay-event="calc" id="NF-calc" name="NF-calc" authorize><i class="layui-icon">&#xe629;</i>月度算薪</button>
            </div>
        </script>
        <script type="text/html" id="currentTableBar">
            <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="details" id="NF-details" authorize><i class="layui-icon">&#xe60b;</i>明细</a>
            <a class="layui-btn layui-btn-xs" lay-event="submit" id="NF-submit" authorize><i class="layui-icon">&#xe609;</i>提交审批</a>
            <a class="layui-btn layui-btn-xs layui-btn-warm" lay-event="approve" id="NF-approve" authorize><i class="layui-icon">&#xe605;</i>审批通过</a>
            <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="reject" id="NF-reject" authorize><i class="layui-icon">&#x1006;</i>驳回</a>
        </script>
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
    </div>
</div>
