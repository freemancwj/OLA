@{
    ViewBag.Title = "我的工资条";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'table', 'common', 'commonTable'], function () {
        var $ = layui.jquery,
            form = layui.form,
            table = layui.table,
            common = layui.common,
            commonTable = layui.commonTable;

        wcLoading.close();

        var statusMap = {
            0: ['草稿', 'layui-bg-gray'],
            1: ['人事已提交', 'layui-bg-blue'],
            2: ['教务已核对', 'layui-bg-cyan'],
            3: ['财务已核对', 'layui-bg-green'],
            4: ['已归档锁定', 'layui-bg-black'],
            5: ['已驳回', 'layui-bg-red']
        };

        //带防伪token的操作类POST请求
        function postAction(url, param, success) {
            var csrfToken = '';
            if ($('[name=__RequestVerificationToken]').length > 0) {
                csrfToken = $('[name=__RequestVerificationToken]').val();
            }
            var index = parent.layer.load(0, { shade: [0.5, '#000'] });
            $.ajax({
                url: common.urlAddTime(url),
                data: param,
                type: 'post',
                dataType: 'json',
                headers: { "X-CSRF-TOKEN": csrfToken },
                success: function (data) {
                    if (data.state == "success") {
                        common.modalMsg(data.message, data.state);
                        if (!!success) success(data);
                    } else {
                        common.modalAlert(data.message, data.state);
                    }
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    common.modalAlert(errorThrown, "error");
                },
                complete: function () {
                    parent.layer.close(index);
                }
            });
        }

        commonTable.rendertable({
            elem: '#currentTableId',
            id: 'currentTableId',
            url: '/SalaryManagement/SalMyPayslip/GetGridJson',
            cols: [[
                { field: 'F_Month', title: '月份', width: 100, align: 'center' },
                { field: 'F_GrossPay', title: '应发工资', width: 110, align: 'right' },
                { field: 'F_SocialPersonal', title: '社保公积金', width: 110, align: 'right' },
                { field: 'F_UnionFee', title: '工会会费', width: 100, align: 'right' },
                { field: 'F_Tax', title: '个税', width: 100, align: 'right' },
                { field: 'F_NetPay', title: '实发工资', width: 110, align: 'right' },
                {
                    field: 'F_Status', title: '状态', width: 110, align: 'center',
                    templet: function (d) {
                        var s = statusMap[d.F_Status] || statusMap[0];
                        return '<span class="layui-badge ' + s[1] + '">' + s[0] + '</span>';
                    }
                },
                { title: '操作', width: 180, toolbar: '#currentTableBar', align: 'center', fixed: 'right' }
            ]]
        });

        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            if (obj.event === 'details') {
                common.modalOpen({
                    title: '我的工资明细',
                    url: '/SalaryManagement/SalMyPayslip/Details?keyValue=' + data.F_Id,
                    width: '900px',
                    height: '90%',
                    btn: []
                });
            }
            else if (obj.event === 'appeal') {
                layer.prompt({ formType: 2, title: '请输入申诉内容（月份：' + (data.F_Month || '') + '）' }, function (value, index) {
                    layer.close(index);
                    if (!value) {
                        common.modalMsg('申诉内容不能为空', 'warning');
                        return false;
                    }
                    postAction('/SalaryManagement/SalMyPayslip/SubmitAppeal', { payslipId: data.F_Id, content: value }, function () {
                    });
                });
            }
        });
    });
</script>

<div class="layuimini-container">
    <div class="layuimini-main">
        <blockquote class="layui-elem-quote">本页面仅显示您本人的工资条数据，如有疑问可点击「申诉」向人事反馈。</blockquote>
        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container">
            </div>
        </script>
        <script type="text/html" id="currentTableBar">
            <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="details"><i class="layui-icon">&#xe60b;</i>查看明细</a>
            <a class="layui-btn layui-btn-xs layui-btn-warm" lay-event="appeal"><i class="layui-icon">&#xe606;</i>申诉</a>
        </script>
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
    </div>
</div>
