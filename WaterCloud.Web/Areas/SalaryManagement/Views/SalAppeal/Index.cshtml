@{
    ViewBag.Title = "薪酬申诉";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'table', 'laydate', 'common', 'commonTable', 'optimizeSelectOption'], function () {
        var $ = layui.jquery,
            form = layui.form,
            table = layui.table,
            laydate = layui.laydate,
            common = layui.common,
            commonTable = layui.commonTable;

        //权限控制(js是值传递)
        currentTableBar.innerHTML = common.authorizeButtonNew(currentTableBar.innerHTML);
        toolbarDemo.innerHTML = common.authorizeButtonNew(toolbarDemo.innerHTML);
        wcLoading.close();

        laydate.render({ elem: '#F_Month', type: 'month' });

        //带防伪token的操作类POST请求
        function postAction(url, param, success) {
            var csrfToken = '';
            if ($('[name=__RequestVerificationToken]').length > 0) {
                csrfToken = $('[name=__RequestVerificationToken]').val();
            }
            var index = parent.layer.load(0, { shade: [0.5, '#000'] });
            $.ajax({
                url: common.urlAddTime(url),
                data: param,
                type: 'post',
                dataType: 'json',
                headers: { "X-CSRF-TOKEN": csrfToken },
                success: function (data) {
                    if (data.state == "success") {
                        common.modalMsg(data.message, data.state);
                        if (!!success) success(data);
                    } else {
                        common.modalAlert(data.message, data.state);
                    }
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    common.modalAlert(errorThrown, "error");
                },
                complete: function () {
                    parent.layer.close(index);
                }
            });
        }

        commonTable.rendertable({
            elem: '#currentTableId',
            id: 'currentTableId',
            url: '/SalaryManagement/SalAppeal/GetGridJson',
            cols: [[
                { field: 'F_Month', title: '月份', width: 90, align: 'center' },
                { field: 'F_Account', title: '账号', width: 100 },
                { field: 'F_RealName', title: '姓名', width: 100 },
                { field: 'F_Content', title: '申诉内容', minWidth: 220 },
                {
                    field: 'F_Status', title: '状态', width: 90, align: 'center',
                    templet: function (d) {
                        return d.F_Status == 1
                            ? '<span class="layui-badge layui-bg-green">已处理</span>'
                            : '<span class="layui-badge layui-bg-orange">待处理</span>';
                    }
                },
                { field: 'F_Reply', title: '回复', minWidth: 200 },
                {
                    field: 'F_ReplyTime', title: '回复时间', width: 160,
                    templet: function (d) { return d.F_ReplyTime ? String(d.F_ReplyTime).replace('T', ' ').substring(0, 19) : ''; }
                },
                {
                    field: 'F_CreatorTime', title: '提交时间', width: 160,
                    templet: function (d) { return d.F_CreatorTime ? String(d.F_CreatorTime).replace('T', ' ').substring(0, 19) : ''; }
                },
                { title: '操作', width: 120, toolbar: '#currentTableBar', align: 'center', fixed: 'right' }
            ]]
        });

        form.on('submit(data-search-btn)', function (data) {
            commonTable.reloadtable({
                elem: 'currentTableId',
                curr: 1,
                where: {
                    month: $('#F_Month').val(),
                    keyword: $('#txt_keyword').val(),
                    status: $('#status').val()
                }
            });
            return false;
        });

        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            if (obj.event === 'reply') {
                if (data.F_Status == 1) {
                    common.modalMsg('该申诉已处理', 'warning');
                    return false;
                }
                layer.prompt({ formType: 2, title: '请输入回复内容' }, function (value, index) {
                    layer.close(index);
                    if (!value) {
                        common.modalMsg('回复内容不能为空', 'warning');
                        return false;
                    }
                    postAction('/SalaryManagement/SalAppeal/Reply', { keyValue: data.F_Id, reply: value }, function () {
                        commonTable.reloadtable({ elem: 'currentTableId' });
                    });
                });
            }
        });
    });
</script>

<div class="layuimini-container">
    <div class="layuimini-main">
        <fieldset class="table-search-fieldset">
            <legend>搜索信息</legend>
            <div style="margin: 10px 10px 10px 10px">
                <form class="layui-form layui-form-pane">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">月份:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="F_Month" name="F_Month" autocomplete="off" class="layui-input" placeholder="yyyy-MM">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">关键字:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="txt_keyword" name="txt_keyword" autocomplete="off" class="layui-input" placeholder="账号/姓名">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">状态:</label>
                            <div class="layui-input-inline">
                                <select id="status" name="status">
                                    <option value="">全部</option>
                                    <option value="0">待处理</option>
                                    <option value="1">已处理</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>
        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container">
            </div>
        </script>
        <script type="text/html" id="currentTableBar">
            {{# if(d.F_Status != 1){ }}
            <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="reply" id="NF-reply" authorize><i class="layui-icon">&#xe642;</i>回复处理</a>
            {{# } }}
        </script>
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
    </div>
</div>
