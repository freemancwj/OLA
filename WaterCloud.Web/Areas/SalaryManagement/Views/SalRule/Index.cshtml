@{
    ViewBag.Title = "薪酬规则配置";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'common'], function () {
        var $ = layui.jquery,
            form = layui.form,
            common = layui.common;

        $(function () {
            initControl();
        });
        wcLoading.close();

        function initControl() {
            common.ajax({
                url: '/SalaryManagement/SalRule/GetRuleJson',
                async: false,
                success: function (data) {
                    common.val('adminform', data);
                }
            });
        }

        // 监听提交
        form.on('submit(saveBtn)', function (data) {
            common.submitForm({
                url: '/SalaryManagement/SalRule/SaveRule',
                param: data.field,
                close: false,
                success: function () {
                }
            });
            return false;
        });
    });
</script>

