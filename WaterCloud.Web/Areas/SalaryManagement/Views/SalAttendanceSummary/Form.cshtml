@{
    ViewBag.Title = "考勤汇总";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'laydate', 'common', 'optimizeSelectOption'], function () {
        var form = layui.form,
            $ = layui.jquery,
            laydate = layui.laydate,
            common = layui.common;
        var keyValue = $.request("keyValue");

        laydate.render({ elem: '#F_Month', type: 'month' });

        $(function () {
            initControl();
        });
        wcLoading.close();

        function initControl() {
            if (!keyValue) {
                // 新增模式：加载已建档教职工
                $("#F_UserId").bindSelect({
                    url: "/SalaryManagement/SalAttendanceSummary/GetProfileUserListJson",
                    id: "F_Id",
                    text: "F_RealName",
                    search: true
                });
            } else {
                // 编辑模式：隐藏人员选择，加载数据
                $('#userItem').hide();
                $('#F_UserId').removeAttr('lay-verify');
                common.ajax({
                    url: '/SalaryManagement/SalAttendanceSummary/GetFormJson',
                    data: { keyValue: keyValue },
                    async: false,
                    success: function (data) {
                        common.val('adminform', data);
                        if (!!data.F_Month) {
                            $('#F_Month').val(String(data.F_Month).substring(0, 7));
                        }
                        // 保留人员绑定（隐藏选择但仍需回传）
                        if (!!data.F_UserId) {
                            $('#F_UserId').append('<option value="' + data.F_UserId + '" selected>' + data.F_UserId + '</option>');
                        }
                    }
                });
            }
            form.render('select');
        }

        // 监听提交
        form.on('submit(saveBtn)', function (data) {
            if (!keyValue && !data.field.F_UserId) {
                common.modalMsg('请选择教职工', 'warning');
                return false;
            }
            common.submitForm({
                url: '/SalaryManagement/SalAttendanceSummary/SubmitForm?keyValue=' + (keyValue || ''),
                param: data.field,
                success: function () {
                    common.parentreload('data-search-btn');
                }
            });
            return false;
        });
    });
</script>

<body>
    <div class="layuimini-container">
        <div class="layuimini-main">
            <div class="layui-form layuimini-form" lay-filter="adminform" id="formMain">
                <div class="layui-form-item" id="userItem">
                    <label class="layui-form-label required">选择教职工</label>
                    <div class="layui-input-block">
                        <select id="F_UserId" name="F_UserId" lay-verify="required" lay-search>
                            <option value="">请选择教职工</option>
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label required">月份</label>
                    <div class="layui-input-block">
                        <input type="text" id="F_Month" name="F_Month" lay-verify="required" autocomplete="off" placeholder="yyyy-MM" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item">
                    <div class="layui-inline">
                        <label class="layui-form-label">病假天数</label>
                        <div class="layui-input-inline">
                            <input type="number" id="F_SickLeaveDays" name="F_SickLeaveDays" autocomplete="off" step="0.5" min="0" class="layui-input">
                        </div>
                    </div>
                    <div class="layui-inline">
                        <label class="layui-form-label">事假天数</label>
                        <div class="layui-input-inline">
                            <input type="number" id="F_PersonalLeaveDays" name="F_PersonalLeaveDays" autocomplete="off" step="0.5" min="0" class="layui-input">
                        </div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <div class="layui-inline">
                        <label class="layui-form-label">旷工天数</label>
                        <div class="layui-input-inline">
                            <input type="number" id="F_AbsentDays" name="F_AbsentDays" autocomplete="off" step="0.5" min="0" class="layui-input">
                        </div>
                    </div>
                    <div class="layui-inline">
                        <label class="layui-form-label">迟到次数</label>
                        <div class="layui-input-inline">
                            <input type="number" id="F_LateCount" name="F_LateCount" autocomplete="off" step="1" min="0" class="layui-input">
                        </div>
                    </div>
                    <div class="layui-inline">
                        <label class="layui-form-label">早退次数</label>
                        <div class="layui-input-inline">
                            <input type="number" id="F_EarlyCount" name="F_EarlyCount" autocomplete="off" step="1" min="0" class="layui-input">
                        </div>
                    </div>
                </div>
                <div class="layui-form-item layui-form-text">
                    <label class="layui-form-label">备注</label>
                    <div class="layui-input-block">
                        <textarea id="F_Remark" name="F_Remark" maxlength="500" placeholder="请输入备注" class="layui-textarea"></textarea>
                    </div>
                </div>
                <div class="layui-form-item layui-hide">
                    <button class="layui-btn site-demo-active" lay-submit id="submit" lay-filter="saveBtn">确认保存</button>
                </div>
            </div>
        </div>
    </div>
</body>
