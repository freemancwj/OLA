@{
    ViewBag.Title = "员工打卡";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .clock-panel { text-align: center; padding: 30px 20px; }
    .clock-time { font-size: 48px; font-weight: bold; color: #1E9FFF; margin: 10px 0; font-family: 'Consolas', monospace; }
    .clock-date { font-size: 16px; color: #666; margin-bottom: 20px; }
    .clock-btn { width: 160px; height: 160px; border-radius: 50%; font-size: 22px; margin: 10px; }
    .clock-status { margin: 15px 0; font-size: 14px; }
    .status-tag { display: inline-block; padding: 4px 12px; border-radius: 12px; margin: 0 5px; }
    .status-normal { background: #f0f9eb; color: #67c23a; }
    .status-late { background: #fdf6ec; color: #e6a23c; }
    .status-early { background: #fef0f0; color: #f56c6c; }
    .status-none { background: #f4f4f5; color: #909399; }
    .rule-info { background: #f8f8f8; border-radius: 8px; padding: 15px; margin: 20px auto; max-width: 400px; text-align: left; }
    .rule-info p { margin: 5px 0; color: #666; }
</style>
<script>
    layui.use(['jquery', 'form', 'table', 'common', 'commonTable', 'laydate'], function () {
        var $ = layui.jquery,
            form = layui.form,
            table = layui.table,
            laydate = layui.laydate,
            common = layui.common,
            commonTable = layui.commonTable;

        var rule = null;
        var todayRecord = null;

        // 实时时钟
        function tick() {
            var now = new Date();
            $('#currentTime').text(now.toTimeString().substring(0, 8));
            $('#currentDate').text(now.getFullYear() + '年' + (now.getMonth() + 1) + '月' + now.getDate() + '日 ' + ['周日','周一','周二','周三','周四','周五','周六'][now.getDay()]);
        }
        tick();
        setInterval(tick, 1000);

        // 加载今日状态
        function loadToday() {
            common.ajax({
                url: '/HRManagement/AttendanceClock/GetTodayStatusJson',
                async: false,
                success: function (data) {
                    rule = data.Rule;
                    todayRecord = data.Record;
                    renderStatus();
                }
            });
        }

        function renderStatus() {
            if (rule) {
                $('#ruleStart').text(rule.F_StartTime || '--');
                $('#ruleEnd').text(rule.F_EndTime || '--');
                $('#ruleLate').text((rule.F_LateGrace || 0) + '分钟');
                $('#ruleEarly').text((rule.F_EarlyGrace || 0) + '分钟');
            }
            var inHtml = '<span class="status-tag status-none">未打卡</span>';
            var outHtml = '<span class="status-tag status-none">未打卡</span>';
            if (todayRecord) {
                if (todayRecord.F_ClockInTime) {
                    var cls = todayRecord.F_ClockInStatus == 0 ? 'status-normal' : 'status-late';
                    var txt = todayRecord.F_ClockInStatus == 0 ? '正常' : '迟到';
                    inHtml = '<span class="status-tag ' + cls + '">' + txt + ' ' + formatTime(todayRecord.F_ClockInTime) + '</span>';
                }
                if (todayRecord.F_ClockOutTime) {
                    var cls = todayRecord.F_ClockOutStatus == 0 ? 'status-normal' : 'status-early';
                    var txt = todayRecord.F_ClockOutStatus == 0 ? '正常' : '早退';
                    outHtml = '<span class="status-tag ' + cls + '">' + txt + ' ' + formatTime(todayRecord.F_ClockOutTime) + '</span>';
                }
            }
            $('#clockInStatus').html(inHtml);
            $('#clockOutStatus').html(outHtml);
            $('#btnClockIn').prop('disabled', !!(todayRecord && todayRecord.F_ClockInTime)).toggleClass('layui-btn-disabled', !!(todayRecord && todayRecord.F_ClockInTime));
            $('#btnClockOut').prop('disabled', !!(todayRecord && todayRecord.F_ClockOutTime)).toggleClass('layui-btn-disabled', !!(todayRecord && todayRecord.F_ClockOutTime));
        }

        function formatTime(dt) {
            if (!dt) return '';
            var s = String(dt).replace('T', ' ');
            return s.substring(11, 16);
        }

        $('#btnClockIn').on('click', function () {
            common.submitForm({
                url: '/HRManagement/AttendanceClock/ClockIn',
                param: {},
                close: false,
                success: function (result) {
                    common.modalMsg(result.message || '打卡成功', 'success');
                    loadToday();
                    commonTable.reloadtable({ elem: 'currentTableId' });
                }
            });
        });

        $('#btnClockOut').on('click', function () {
            common.submitForm({
                url: '/HRManagement/AttendanceClock/ClockOut',
                param: {},
                close: false,
                success: function (result) {
                    common.modalMsg(result.message || '打卡成功', 'success');
                    loadToday();
                    commonTable.reloadtable({ elem: 'currentTableId' });
                }
            });
        });

        // 月份选择
        laydate.render({ elem: '#month', type: 'month' });

        // 我的打卡记录
        commonTable.rendertable({
            elem: '#currentTableId',
            id: 'currentTableId',
            url: '/HRManagement/AttendanceClock/GetMyGridJson',
            cols: [[
                { field: 'F_Date', title: '日期', width: 120, templet: function (d) { return d.F_Date ? String(d.F_Date).substring(0, 10) : ''; } },
                { field: 'F_ClockInTime', title: '上班打卡', width: 110, align: 'center', templet: function (d) { return d.F_ClockInTime ? formatTime(d.F_ClockInTime) : '<span class="layui-badge layui-bg-gray">缺卡</span>'; } },
                {
                    field: 'F_ClockInStatus', title: '上班状态', width: 100, align: 'center',
                    templet: function (d) {
                        if (d.F_ClockInStatus === 0) return '<span class="layui-badge layui-bg-green">正常</span>';
                        if (d.F_ClockInStatus === 1) return '<span class="layui-badge layui-bg-orange">迟到</span>';
                        return '<span class="layui-badge layui-bg-gray">缺卡</span>';
                    }
                },
                { field: 'F_ClockOutTime', title: '下班打卡', width: 110, align: 'center', templet: function (d) { return d.F_ClockOutTime ? formatTime(d.F_ClockOutTime) : '<span class="layui-badge layui-bg-gray">缺卡</span>'; } },
                {
                    field: 'F_ClockOutStatus', title: '下班状态', width: 100, align: 'center',
                    templet: function (d) {
                        if (d.F_ClockOutStatus === 0) return '<span class="layui-badge layui-bg-green">正常</span>';
                        if (d.F_ClockOutStatus === 1) return '<span class="layui-badge layui-bg-red">早退</span>';
                        return '<span class="layui-badge layui-bg-gray">缺卡</span>';
                    }
                },
                { field: 'F_Remark', title: '备注', minWidth: 150 }
            ]]
        });

        form.on('submit(data-search-btn)', function (data) {
            commonTable.reloadtable({
                elem: 'currentTableId',
                curr: 1,
                where: { month: $('#month').val() }
            });
            return false;
        });

        loadToday();
        wcLoading.close();
    });
</script>

<div class="layuimini-container">
    <div class="layuimini-main">
        <div class="layui-row layui-col-space15">
            <div class="layui-col-md5">
                <div class="layui-card">
                    <div class="layui-card-header">今日打卡</div>
                    <div class="layui-card-body clock-panel">
                        <div class="clock-date" id="currentDate"></div>
                        <div class="clock-time" id="currentTime">--:--:--</div>
                        <div class="clock-status">
                            <span>上班：</span><span id="clockInStatus"></span>
                        </div>
                        <div class="clock-status">
                            <span>下班：</span><span id="clockOutStatus"></span>
                        </div>
                        <div style="margin-top: 20px;">
                            <button class="layui-btn layui-btn-lg layui-btn-normal clock-btn" id="btnClockIn" style="width:140px;height:60px;font-size:18px;border-radius:8px;">上班打卡</button>
                            <button class="layui-btn layui-btn-lg layui-btn-warm clock-btn" id="btnClockOut" style="width:140px;height:60px;font-size:18px;border-radius:8px;">下班打卡</button>
                        </div>
                        <div class="rule-info">
                            <p><strong>打卡规则：</strong></p>
                            <p>上班时间：<span id="ruleStart">--</span>，迟到宽限：<span id="ruleLate">--</span></p>
                            <p>下班时间：<span id="ruleEnd">--</span>，早退宽限：<span id="ruleEarly">--</span></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="layui-col-md7">
                <div class="layui-card">
                    <div class="layui-card-header">我的打卡记录</div>
                    <div class="layui-card-body">
                        <div style="margin-bottom: 10px;">
                            <form class="layui-form layui-form-pane">
                                <div class="layui-inline">
                                    <label class="layui-form-label">月份:</label>
                                    <div class="layui-input-inline">
                                        <input type="text" id="month" name="month" autocomplete="off" class="layui-input" placeholder="选择月份">
                                    </div>
                                </div>
                                <div class="layui-inline">
                                    <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button>
                                </div>
                            </form>
                        </div>
                        <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
