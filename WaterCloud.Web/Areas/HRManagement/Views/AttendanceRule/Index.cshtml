@{
    ViewBag.Title = "打卡规则";
    Layout = "~/Views/Shared/_Form.cshtml";
    var aMapKey = ViewBag.AMapKey ?? "";
}
<script>
    // 动态加载高德地图（仅当配置了 Key 时）
    var aMapKey = '@aMapKey';
    if (aMapKey) {
        window._amapLoaded = new Promise(function (resolve, reject) {
            var script = document.createElement('script');
            script.src = 'https://webapi.amap.com/maps?v=2.0&key=' + aMapKey + '&plugin=AMap.Geocoder';
            script.onload = function () { if (window.AMap) resolve(window.AMap); else reject(new Error('AMap not available')); };
            script.onerror = function () { reject(new Error('AMap script load failed')); };
            document.head.appendChild(script);
        });
    }
</script>
<script>
    layui.use(['jquery', 'form', 'common'], function () {
        var form = layui.form,
            $ = layui.jquery,
            common = layui.common;
        var map = null;
        var marker = null;
        var circle = null;
        var geocoder = null;

        $(function () {
            initControl();
        });
        wcLoading.close();

        function initControl() {
            common.ajax({
                url: '/HRManagement/AttendanceRule/GetFormJson',
                async: false,
                success: function (data) {
                    if (data) {
                        $('#F_StartTime').val(data.F_StartTime || '08:30');
                        $('#F_EndTime').val(data.F_EndTime || '17:30');
                        $('#F_LateGrace').val(data.F_LateGrace == null ? 10 : data.F_LateGrace);
                        $('#F_EarlyGrace').val(data.F_EarlyGrace == null ? 10 : data.F_EarlyGrace);
                        $('#F_EnabledMark').prop('checked', data.F_EnabledMark === true || data.F_EnabledMark === 1);
                        $('#F_Longitude').val(data.F_Longitude == null ? '' : data.F_Longitude);
                        $('#F_Latitude').val(data.F_Latitude == null ? '' : data.F_Latitude);
                        $('#F_PoiName').val(data.F_PoiName || '');
                        $('#F_Radius').val(data.F_Radius == null ? 200 : data.F_Radius);
                    }
                    form.render();
                }
            });
            initMap();
        }

        function initMap() {
            if (!window._amapLoaded) {
                $('#mapContainer').html('<div style="padding:20px;color:#999;text-align:center;border:1px dashed #ccc;background:#fafafa;">未配置高德地图 Key。请在 appsettings.json 的 AMap:Key 填入你申请的 Key（申请地址：https://console.amap.com/）</div>');
                return;
            }
            window._amapLoaded.then(function (AMap) {
                map = new AMap.Map('mapContainer', {
                    zoom: 14,
                    center: [116.397428, 39.90923] // 默认北京，后续会被保存的坐标覆盖
                });
                geocoder = new AMap.Geocoder();
                // 已有坐标则直接定位
                var lng = parseFloat($('#F_Longitude').val());
                var lat = parseFloat($('#F_Latitude').val());
                if (!isNaN(lng) && !isNaN(lat)) {
                    placeMarker(lng, lat);
                }
                // 半径圆
                drawCircle();
                map.on('click', function (e) {
                    placeMarker(e.lnglat.getLng(), e.lnglat.getLat());
                    reverseGeocode(e.lnglat.getLng(), e.lnglat.getLat());
                });
                map.on('dragend', function () {
                    var center = map.getCenter();
                    placeMarker(center.getLng(), center.getLat());
                    reverseGeocode(center.getLng(), center.getLat());
                });
                $('#mapHint').text('点击地图或拖动中心点来设置打卡范围');
            }).catch(function (err) {
                $('#mapContainer').html('<div style="padding:20px;color:#c00;text-align:center;">地图加载失败：' + err.message + '</div>');
            });
        }

        function placeMarker(lng, lat) {
            $('#F_Longitude').val(+lng.toFixed(6));
            $('#F_Latitude').val(+lat.toFixed(6));
            if (marker) {
                marker.setPosition([lng, lat]);
            } else {
                marker = new AMap.Marker({ position: [lng, lat], map: map, draggable: true });
                marker.on('dragend', function (e) {
                    var p = e.lnglat;
                    $('#F_Longitude').val(+p.getLng().toFixed(6));
                    $('#F_Latitude').val(+p.getLat().toFixed(6));
                    reverseGeocode(p.getLng(), p.getLat());
                    drawCircle();
                });
            }
            drawCircle();
        }

        function drawCircle() {
            if (!map || !marker) return;
            var r = parseInt($('#F_Radius').val()) || 200;
            if (circle) { map.remove(circle); }
            var pos = marker.getPosition();
            circle = new AMap.Circle({
                center: [pos.getLng(), pos.getLat()],
                radius: r,
                strokeColor: '#1E9FFF',
                strokeOpacity: 0.7,
                fillColor: '#1E9FFF',
                fillOpacity: 0.15
            });
            circle.setMap(map);
            // 保持 Marker 在圆上可见
            map.setFitView([marker, circle], false, [30, 30, 30, 30]);
        }

        function reverseGeocode(lng, lat) {
            if (!geocoder) return;
            geocoder.getAddress([lng, lat], function (status, result) {
                if (status === 'complete' && result.info === 'OK' && result.regeocode) {
                    var addr = result.regeocode.formattedAddress || '';
                    $('#F_PoiName').val(addr);
                }
            });
        }

        // 搜索定位
        $('#btnSearchAddr').on('click', function () {
            if (!window.AMap) { common.modalMsg('地图未加载', 'warning'); return; }
            var kw = $('#txtAddrSearch').val().trim();
            if (!kw) { common.modalMsg('请输入要搜索的地点', 'warning'); return; }
            geocoder.getLocation(kw, function (status, result) {
                if (status === 'complete' && result.info === 'OK' && result.geocodes && result.geocodes.length > 0) {
                    var g = result.geocodes[0];
                    map.setZoomAndCenter(16, [g.location.lng, g.location.lat]);
                    placeMarker(g.location.lng, g.location.lat);
                    $('#F_PoiName').val(g.formattedAddress || kw);
                } else {
                    common.modalMsg('未找到该地点', 'warning');
                }
            });
        });

        // 半径变化时重绘圆
        $('#F_Radius').on('input change', function () { drawCircle(); });

        // 定位到当前位置
        $('#btnLocateMe').on('click', function () {
            if (!window.AMap) { common.modalMsg('地图未加载', 'warning'); return; }
            map.plugin(['AMap.Geolocation'], function () {
                var geo = new AMap.Geolocation({ enableHighAccuracy: true, timeout: 8000 });
                map.addControl(geo);
                geo.getCurrentPosition(function (status, result) {
                    if (status === 'complete') {
                        placeMarker(result.position.lng, result.position.lat);
                        reverseGeocode(result.position.lng, result.position.lat);
                    } else {
                        common.modalMsg('无法获取当前位置：' + (result.message || status), 'warning');
                    }
                });
            });
        });

        // 监听提交
        form.on('submit(saveBtn)', function (data) {
            data.field.F_EnabledMark = $('#F_EnabledMark').prop('checked');
            var lng = $('#F_Longitude').val();
            var lat = $('#F_Latitude').val();
            if (lng) data.field.F_Longitude = lng;
            else data.field.F_Longitude = null;
            if (lat) data.field.F_Latitude = lat;
            else data.field.F_Latitude = null;
            common.submitForm({
                url: '/HRManagement/AttendanceRule/SubmitForm',
                param: data.field,
                close: false,
                success: function () {
                    common.modalMsg('打卡规则已保存', 'success');
                }
            });
            return false;
        });
    });
</script>

<body>
    <div class="layuimini-container">
        <div class="layuimini-main">
            <div class="layui-form layuimini-form" lay-filter="adminform">
                <div class="layui-form-item">
                    <label class="layui-form-label required">上班时间</label>
                    <div class="layui-input-inline">
                        <input type="text" id="F_StartTime" name="F_StartTime" lay-verify="required" placeholder="HH:mm，如 08:30" maxlength="5" autocomplete="off" class="layui-input">
                    </div>
                    <div class="layui-form-mid layui-word-aux">员工上班打卡的基准时间</div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label required">下班时间</label>
                    <div class="layui-input-inline">
                        <input type="text" id="F_EndTime" name="F_EndTime" lay-verify="required" placeholder="HH:mm，如 17:30" maxlength="5" autocomplete="off" class="layui-input">
                    </div>
                    <div class="layui-form-mid layui-word-aux">员工下班打卡的基准时间</div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">迟到宽限</label>
                    <div class="layui-input-inline">
                        <input type="number" id="F_LateGrace" name="F_LateGrace" value="10" min="0" max="120" autocomplete="off" class="layui-input">
                    </div>
                    <div class="layui-form-mid layui-word-aux">分钟。上班时间后超过宽限打卡算迟到</div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">早退宽限</label>
                    <div class="layui-input-inline">
                        <input type="number" id="F_EarlyGrace" name="F_EarlyGrace" value="10" min="0" max="120" autocomplete="off" class="layui-input">
                    </div>
                    <div class="layui-form-mid layui-word-aux">分钟。下班时间前超过宽限打卡算早退</div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">打卡地点</label>
                    <div class="layui-input-block">
                        <input type="hidden" id="F_Longitude" name="F_Longitude">
                        <input type="hidden" id="F_Latitude" name="F_Latitude">
                        <input type="text" id="F_PoiName" name="F_PoiName" placeholder="点地图选点或搜索定位" readonly class="layui-input" style="width:420px;display:inline-block;">
                        <button type="button" class="layui-btn layui-btn-primary" id="btnLocateMe"><i class="layui-icon">&#xe671;</i>我的位置</button>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">快速搜索</label>
                    <div class="layui-input-block">
                        <input type="text" id="txtAddrSearch" placeholder="输入地点名称，如：北京市朝阳区政府" autocomplete="off" class="layui-input" style="width:360px;display:inline-block;">
                        <button type="button" class="layui-btn" id="btnSearchAddr"><i class="layui-icon">&#xe615;</i>搜索</button>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">有效范围</label>
                    <div class="layui-input-inline" style="width:120px;">
                        <input type="number" id="F_Radius" name="F_Radius" value="200" min="50" max="5000" step="10" autocomplete="off" class="layui-input">
                    </div>
                    <div class="layui-form-mid layui-word-aux">米。GPS 定位在此半径内算合法打卡</div>
                </div>
                <div class="layui-form-item">
                    <div class="layui-input-block">
                        <div id="mapContainer" style="width:760px;height:400px;border:1px solid #e6e6e6;border-radius:4px;"></div>
                        <div id="mapHint" style="color:#999;font-size:12px;margin-top:6px;">加载中...</div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">是否启用</label>
                    <div class="layui-input-block">
                        <input type="checkbox" id="F_EnabledMark" name="F_EnabledMark" lay-skin="switch" lay-text="启用|禁用" checked>
                    </div>
                </div>
                <div class="layui-form-item">
                    <div class="layui-input-block">
                        <button class="layui-btn" lay-submit lay-filter="saveBtn">保存规则</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
