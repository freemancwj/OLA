@{
    ViewBag.Title = "考试";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'laydate', 'table', 'layer', 'common', 'optimizeSelectOption'], function () {
        var $ = layui.jquery,
            form = layui.form,
            laydate = layui.laydate,
            table = layui.table,
            layer = layui.layer,
            common = layui.common;
        var keyValue = $.request("keyValue");
        //已选试卷题目：{ F_QuestionId, F_Type, F_TypeName, F_Content, F_Score }
        var questions = [];
        var courseList = [];

        common.authorizeFields('adminform');

        function esc(text) {
            return String(text == null ? '' : text)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function fillSelect(selector, list, idField, nameField, placeholder) {
            var html = '<option value="">' + placeholder + '</option>';
            $.each(list, function (i, item) {
                html += '<option value="' + item[idField] + '">' + item[nameField] + '</option>';
            });
            $(selector).html(html);
        }

        function toDateText(value) {
            if (!value) { return ''; }
            var text = String(value).replace(/\//g, '-').replace('T', ' ');
            return text.length > 19 ? text.substring(0, 19) : text;
        }

        function initControl() {
            common.ajax({
                url: '/InstructionalManagement/Exam/GetCourseListJson', async: false,
                success: function (data) {
                    courseList = data || [];
                    fillSelect('#F_CourseId', courseList, 'F_Id', 'F_ItemName', '请选择科目');
                }
            });
            common.ajax({
                url: '/InstructionalManagement/Exam/GetClassListJson', async: false,
                success: function (data) { fillSelect('#F_ClassId', data, 'F_Id', 'F_FullName', '请选择班级'); }
            });
            laydate.render({ elem: '#F_StartTime', type: 'datetime', format: 'yyyy-MM-dd HH:mm:ss' });
            laydate.render({ elem: '#F_EndTime', type: 'datetime', format: 'yyyy-MM-dd HH:mm:ss' });
            form.render('select');
        }

        function loadForm() {
            common.ajax({
                url: '/InstructionalManagement/Exam/GetFormJson',
                data: { keyValue: keyValue },
                async: false,
                success: function (data) {
                    $('#F_Id').val(data.F_Id || '');
                    $('#F_Title').val(data.F_Title || '');
                    $('#F_CourseId').val(data.F_CourseId || '');
                    $('#F_ClassId').val(data.F_ClassId || '');
                    $('#F_Type').val(data.F_Type || 1);
                    $('#F_StartTime').val(toDateText(data.F_StartTime));
                    $('#F_EndTime').val(toDateText(data.F_EndTime));
                    $('#F_Duration').val(data.F_Duration || 60);
                    $('#F_PassScore').val(data.F_PassScore != null ? data.F_PassScore : 60);
                    $('#F_Remark').val(data.F_Remark || '');
                    questions = [];
                    $.each(data.Questions || [], function (i, item) {
                        questions.push({
                            F_QuestionId: item.F_QuestionId,
                            F_Type: item.F_Type,
                            F_TypeName: item.F_TypeName || questionTypeName(item.F_Type),
                            F_Content: item.F_Content,
                            F_Score: item.F_Score != null ? item.F_Score : 0
                        });
                    });
                }
            });
            form.render();
        }

        function questionTypeName(type) {
            if (type === 1) { return '单选题'; }
            if (type === 2) { return '多选题'; }
            if (type === 3) { return '判断题'; }
            if (type === 4) { return '简答题'; }
            return '';
        }

        function totalScore() {
            var total = 0;
            $.each(questions, function (i, item) { total += (item.F_Score || 0); });
            return Math.round(total * 10) / 10;
        }

        function updateStats() {
            $('#qStats').text('已选 ' + questions.length + ' 题，合计 ' + totalScore() + ' 分');
        }

        function renderQuestions() {
            var html = '';
            if (questions.length === 0) {
                html = '<tr><td colspan="5" class="layui-color-gray" style="text-align:center;">还没有选择题目，请点击“选择题目”</td></tr>';
            }
            else {
                $.each(questions, function (i, item) {
                    html += '<tr>'
                        + '<td style="text-align:center;">' + (i + 1) + '</td>'
                        + '<td>' + esc(item.F_Content) + '</td>'
                        + '<td style="text-align:center;">' + esc(item.F_TypeName) + '</td>'
                        + '<td><input type="number" min="0" step="0.5" class="layui-input q-score" data-index="' + i + '" value="' + (item.F_Score || 0) + '"></td>'
                        + '<td style="text-align:center;">'
                        + '<a class="layui-btn layui-btn-xs layui-btn-primary" data-act="up" data-index="' + i + '">上移</a>'
                        + '<a class="layui-btn layui-btn-xs layui-btn-primary" data-act="down" data-index="' + i + '">下移</a>'
                        + '<a class="layui-btn layui-btn-xs layui-btn-danger" data-act="remove" data-index="' + i + '">移除</a>'
                        + '</td></tr>';
                });
            }
            $('#questionBody').html(html);
            updateStats();
        }

        function addQuestions(list) {
            var exists = {};
            $.each(questions, function (i, item) { exists[item.F_QuestionId] = true; });
            var added = 0, skipped = 0;
            $.each(list, function (i, item) {
                if (exists[item.F_Id || item.F_QuestionId]) { skipped++; return; }
                var questionId = item.F_Id || item.F_QuestionId;
                exists[questionId] = true;
                questions.push({
                    F_QuestionId: questionId,
                    F_Type: item.F_Type,
                    F_TypeName: item.F_TypeName || questionTypeName(item.F_Type),
                    F_Content: item.F_Content,
                    F_Score: item.F_Score != null ? item.F_Score : 0
                });
                added++;
            });
            renderQuestions();
            if (skipped > 0) {
                common.modalMsg('已添加 ' + added + ' 题，' + skipped + ' 题因重复被忽略', 'warning');
            }
        }

        //题库选题弹层
        function openQuestionPicker() {
            var html = '<div style="padding:10px;">'
                + '<div class="layui-form layui-form-pane">'
                + '<div class="layui-form-item" style="margin-bottom:0;">'
                + '<div class="layui-inline"><label class="layui-form-label">科目</label>'
                + '<div class="layui-input-inline" style="width:130px;"><select id="pick_course" lay-search><option value="">全部科目</option></select></div></div>'
                + '<div class="layui-inline"><label class="layui-form-label">题型</label>'
                + '<div class="layui-input-inline" style="width:110px;"><select id="pick_type">'
                + '<option value="">全部题型</option><option value="1">单选题</option><option value="2">多选题</option>'
                + '<option value="3">判断题</option><option value="4">简答题</option></select></div></div>'
                + '<div class="layui-inline"><label class="layui-form-label">关键字</label>'
                + '<div class="layui-input-inline" style="width:160px;"><input type="text" id="pick_keyword" class="layui-input" placeholder="题干关键字"></div></div>'
                + '<div class="layui-inline"><button type="button" class="layui-btn layui-btn-primary" id="pick_search"><i class="layui-icon">&#xe615;</i> 搜索</button></div>'
                + '</div></div>'
                + '<table id="pickTable" lay-filter="pickTable"></table>'
                + '</div>';
            var index = layer.open({
                type: 1,
                title: '选择题库题目',
                area: ['980px', '620px'],
                shade: 0.3,
                content: html,
                success: function () {
                    fillSelect('#pick_course', courseList, 'F_Id', 'F_ItemName', '全部科目');
                    $('#pick_course').val($('#F_CourseId').val() || '');
                    form.render();
                    renderPickTable([]);
                    $('#pick_search').on('click', function () {
                        common.ajax({
                            url: '/InstructionalManagement/Exam/GetQuestionListJson',
                            data: {
                                courseId: $('#pick_course').val(),
                                type: $('#pick_type').val(),
                                keyword: $('#pick_keyword').val()
                            },
                            success: function (data) { renderPickTable(data || []); }
                        });
                    });
                    $('#pick_keyword').on('keydown', function (e) {
                        if (e.keyCode === 13) { e.preventDefault(); $('#pick_search').trigger('click'); }
                    });
                },
                btn: ['确定', '关闭'],
                yes: function (idx) {
                    var checked = table.checkStatus('pickTable').data;
                    if (checked.length === 0) { common.modalMsg('请勾选要添加的题目', 'warning'); return; }
                    addQuestions(checked);
                    layer.close(idx);
                }
            });
        }

        function renderPickTable(data) {
            table.render({
                elem: '#pickTable',
                id: 'pickTable',
                data: data,
                page: false,
                limit: 2000,
                height: 430,
                text: { none: '没有查询到题目' },
                cols: [[
                    { type: 'checkbox', width: 50 },
                    { field: 'F_TypeName', title: '题型', width: 90, align: 'center' },
                    { field: 'F_Content', title: '题干', minWidth: 360 },
                    { field: 'F_Score', title: '题库分值', width: 100, align: 'center' },
                    { field: 'F_CourseName', title: '科目', width: 130 }
                ]]
            });
        }

        $(function () {
            initControl();
            if (!!keyValue) { loadForm(); }
            renderQuestions();
            form.render();

            //题目分值修改
            $('#questionBody').on('input', '.q-score', function () {
                var index = parseInt($(this).data('index'));
                var value = parseFloat($(this).val());
                questions[index].F_Score = isNaN(value) ? 0 : value;
                updateStats();
            });

            //题目上移/下移/移除
            $('#questionBody').on('click', 'a[data-act]', function () {
                var index = parseInt($(this).data('index'));
                var act = $(this).data('act');
                if (act === 'remove') {
                    questions.splice(index, 1);
                }
                else if (act === 'up' && index > 0) {
                    var prev = questions[index - 1];
                    questions[index - 1] = questions[index];
                    questions[index] = prev;
                }
                else if (act === 'down' && index < questions.length - 1) {
                    var next = questions[index + 1];
                    questions[index + 1] = questions[index];
                    questions[index] = next;
                }
                renderQuestions();
            });

            $('#btnPickQuestion').click(function () { openQuestionPicker(); });
        });
        wcLoading.close();

        //监听提交
        form.on('submit(saveBtn)', function (data) {
            var postData = data.field;
            for (var i = 0; i < questions.length; i++) {
                if (questions[i].F_Score == null || questions[i].F_Score <= 0) {
                    common.modalMsg('第 ' + (i + 1) + ' 题的分值必须大于 0', 'warning');
                    return false;
                }
            }
            var rows = [];
            for (var j = 0; j < questions.length; j++) {
                rows.push({
                    F_QuestionId: questions[j].F_QuestionId,
                    F_Score: questions[j].F_Score,
                    F_SortCode: j + 1
                });
            }
            postData.questionsJson = JSON.stringify(rows);
            common.submitForm({
                url: '/InstructionalManagement/Exam/SubmitForm',
                param: postData,
                success: function () {
                    common.parentreload('data-search-btn');
                }
            });
            return false;
        });
    });
</script>

<body>
    <div class="layuimini-container">
        <div class="layuimini-main">
            <div class="layui-form layuimini-form" lay-filter="adminform">
                <input type="hidden" id="F_Id" name="F_Id">
                <div class="layui-form-item">
                    <label class="layui-form-label required">考试标题</label>
                    <div class="layui-input-block">
                        <input type="text" id="F_Title" name="F_Title" autocomplete="off" maxlength="200" lay-verify="required" placeholder="请输入考试标题" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label required">科目</label>
                    <div class="layui-input-block">
                        <select id="F_CourseId" name="F_CourseId" lay-verify="required" lay-search>
                            <option value="">请选择科目</option>
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label required">班级</label>
                    <div class="layui-input-block">
                        <select id="F_ClassId" name="F_ClassId" lay-verify="required" lay-search>
                            <option value="">请选择班级</option>
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label required">考试类型</label>
                    <div class="layui-input-block">
                        <select id="F_Type" name="F_Type" lay-verify="required">
                            <option value="1" selected>章节测试</option>
                            <option value="2">模拟考试</option>
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">开始时间</label>
                    <div class="layui-input-block">
                        <input type="text" id="F_StartTime" name="F_StartTime" autocomplete="off" placeholder="留空表示不限" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">结束时间</label>
                    <div class="layui-input-block">
                        <input type="text" id="F_EndTime" name="F_EndTime" autocomplete="off" placeholder="留空表示不限" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label required">考试时长</label>
                    <div class="layui-input-block">
                        <input type="number" id="F_Duration" name="F_Duration" min="1" max="600" value="60" lay-verify="required|number" autocomplete="off" placeholder="单位：分钟" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">及格分</label>
                    <div class="layui-input-block">
                        <input type="number" id="F_PassScore" name="F_PassScore" min="0" step="0.5" value="60" autocomplete="off" placeholder="请输入及格分" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item layui-form-text">
                    <label class="layui-form-label">备注</label>
                    <div class="layui-input-block">
                        <textarea id="F_Remark" name="F_Remark" maxlength="500" placeholder="考试说明、注意事项等" class="layui-textarea"></textarea>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">试卷题目</label>
                    <div class="layui-input-block">
                        <button type="button" class="layui-btn layui-btn-sm" id="btnPickQuestion"><i class="layui-icon">&#xe654;</i> 选择题目</button>
                        <span class="layui-form-mid" id="qStats">已选 0 题，合计 0 分</span>
                    </div>
                </div>
                <div style="margin:0 15px 15px;">
                    <table class="layui-table" lay-skin="line">
                        <colgroup>
                            <col style="width:60px">
                            <col>
                            <col style="width:100px">
                            <col style="width:120px">
                            <col style="width:190px">
                        </colgroup>
                        <thead>
                            <tr>
                                <th style="text-align:center;">序号</th>
                                <th>题干</th>
                                <th style="text-align:center;">题型</th>
                                <th style="text-align:center;">分值</th>
                                <th style="text-align:center;">操作</th>
                            </tr>
                        </thead>
                        <tbody id="questionBody"></tbody>
                    </table>
                </div>
                <div class="layui-form-item layui-hide">
                    <button class="layui-btn site-demo-active" lay-submit id="submit" lay-filter="saveBtn">确认保存</button>
                </div>
            </div>
        </div>
    </div>
</body>
