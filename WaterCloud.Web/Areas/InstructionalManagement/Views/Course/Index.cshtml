@{
    ViewBag.Title = "课程管理";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<div class="layuimini-container">
    <div class="layuimini-main">
        <div class="layui-btn-group">
            <button id="btn-expand" type="button" class="layui-btn layui-btn-primary layui-btn-sm">
                <i class="layui-icon layui-icon-spread-left"></i> 展开搜索
            </button>
            <button id="btn-refresh" type="button" class="layui-btn layui-btn-primary layui-btn-sm">
                <i class="layui-icon layui-icon-refresh"></i> 刷新
            </button>
        </div>
        <fieldset class="table-search-fieldset layui-hide" id="searchField">
            <div>
                <form class="layui-form layui-form-pane">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">关键字:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="txt_keyword" name="txt_keyword" autocomplete="off" class="layui-input" placeholder="课程/分类/教师">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">分类:</label>
                            <div class="layui-input-inline">
                                <select id="ddl_category" name="ddl_category" lay-search>
                                    <option value="">全部分类</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">状态:</label>
                            <div class="layui-input-inline">
                                <select id="ddl_status" name="ddl_status">
                                    <option value="">全部</option>
                                    <option value="1">已上架</option>
                                    <option value="0">已下架</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn">
                                <i class="layui-icon">&#xe615;</i> 搜 索
                            </button>
                            <button type="button" class="layui-btn layui-btn-primary" id="btn-reset">
                                <i class="layui-icon">&#xe666;</i> 重 置
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>
        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container" id="toolbar">
                <button id="NF-add" name="NF-add" authorize class="layui-btn layui-btn-sm" lay-event="add"><i class="layui-icon">&#xe654;</i>新增课程</button>
                <button id="NF-edit" name="NF-edit" authorize class="layui-btn layui-btn-sm layui-btn-warm layui-hide" lay-event="edit"><i class="layui-icon">&#xe642;</i>修改</button>
                <button id="NF-chapter" name="NF-chapter" authorize class="layui-btn layui-btn-sm layui-btn-normal layui-hide" lay-event="chapter"><i class="layui-icon">&#xe62d;</i>章节管理</button>
                <button id="NF-ware" name="NF-ware" authorize class="layui-btn layui-btn-sm layui-btn-normal layui-hide" lay-event="ware"><i class="layui-icon">&#xe67c;</i>资料管理</button>
                <button id="NF-online" name="NF-online" authorize class="layui-btn layui-btn-sm layui-hide" lay-event="online"><i class="layui-icon">&#xe6c6;</i>上架</button>
                <button id="NF-offline" name="NF-offline" authorize class="layui-btn layui-btn-sm layui-btn-primary layui-hide" lay-event="offline"><i class="layui-icon">&#xe6c7;</i>下架</button>
                <button id="NF-delete" name="NF-delete" authorize class="layui-btn layui-btn-sm layui-btn-danger layui-hide" lay-event="delete"><i class="layui-icon">&#xe640;</i>删除</button>
            </div>
        </script>
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
        <script type="text/html" id="currentTableBar">
            <a id="NF-edit" authorize class="layui-btn layui-btn-xs layui-btn-warm" lay-event="edit">修改</a>
            <a id="NF-chapter" authorize class="layui-btn layui-btn-xs layui-btn-normal" lay-event="chapter">章节</a>
            <a id="NF-ware" authorize class="layui-btn layui-btn-xs layui-btn-normal" lay-event="ware">资料</a>
            <a id="NF-delete" authorize class="layui-btn layui-btn-xs layui-btn-danger" lay-event="delete">删除</a>
        </script>
        <script type="text/html" id="coverTpl">
            {{# if(d.F_Cover){ }}
            <img src="{{d.F_Cover}}" style="height:32px;cursor:pointer;" onclick="event.stopPropagation();var w=window.open();w.document.write('<img src={{d.F_Cover}} style=max-width:100%>');" />
            {{# } else { }}
            <span class="layui-color-gray">无封面</span>
            {{# } }}
        </script>
        <script type="text/html" id="statusTpl">
            {{# if(d.F_Status === 1){ }}
            <span class="layui-badge layui-bg-green">已上架</span>
            {{# } else { }}
            <span class="layui-badge layui-bg-gray">已下架</span>
            {{# } }}
        </script>
    </div>
</div>
<script>
    layui.use(['jquery', 'form', 'table', 'commonTable', 'common', 'optimizeSelectOption'], function () {
        var $ = layui.jquery,
            form = layui.form,
            table = layui.table,
            commonTable = layui.commonTable,
            common = layui.common;

        function loadOptions() {
            common.ajax({
                url: '/InstructionalManagement/CourseCategory/GetTreeSelectJson', async: false,
                success: function (data) {
                    var html = '<option value="">全部分类</option>';
                    $.each(data, function (i, item) { html += '<option value="' + item.F_Id + '">' + item.F_Name + '</option>'; });
                    $('#ddl_category').html(html);
                }
            });
            form.render('select');
        }

        function getSearchParams() {
            return {
                keyword: $('#txt_keyword').val(),
                categoryId: $('#ddl_category').val(),
                status: $('#ddl_status').val()
            };
        }

        function reloadTable() {
            commonTable.reloadtable({ elem: 'currentTableId', curr: 1, where: getSearchParams() });
        }

        loadOptions();
        currentTableBar.innerHTML = common.authorizeButtonNew(currentTableBar.innerHTML);
        toolbarDemo.innerHTML = common.authorizeButtonNew(toolbarDemo.innerHTML);

        commonTable.rendertable({
            elem: '#currentTableId',
            id: 'currentTableId',
            url: '/InstructionalManagement/Course/GetGridJson',
            where: getSearchParams(),
            cols: [[
                { type: "checkbox", width: 50, fixed: 'left' },
                { field: 'F_Cover', title: '封面', width: 90, templet: '#coverTpl', align: 'center' },
                { field: 'F_Name', title: '课程名称', minWidth: 180, sort: true },
                { field: 'F_CategoryName', title: '分类', width: 110, sort: true },
                { field: 'F_TeacherName', title: '授课教师', width: 100, sort: true },
                { field: 'F_MajorName', title: '所属专业', width: 120 },
                { field: 'F_Credit', title: '学分', width: 70, align: 'center' },
                { field: 'F_Period', title: '学时', width: 70, align: 'center' },
                { field: 'F_Nature', title: '性质', width: 80, align: 'center' },
                { field: 'ChapterCount', title: '章节数', width: 85, align: 'center' },
                { field: 'LessonCount', title: '课时数', width: 85, align: 'center' },
                { field: 'F_Status', title: '状态', width: 90, templet: '#statusTpl', align: 'center', sort: true },
                { field: 'F_SortCode', title: '排序', width: 70, align: 'center', sort: true },
                { field: 'F_CreatorTime', title: '创建时间', width: 160, sort: true },
                { title: '操作', width: 210, toolbar: '#currentTableBar', align: "center", fixed: 'right' }
            ]]
        });

        $('#btn-expand').click(function () {
            var $searchField = $('#searchField');
            if ($searchField.hasClass('layui-hide')) {
                $searchField.removeClass('layui-hide');
                $(this).html('<i class="layui-icon layui-icon-shrink-right"></i> 收起搜索');
            } else {
                $searchField.addClass('layui-hide');
                $(this).html('<i class="layui-icon layui-icon-spread-left"></i> 展开搜索');
            }
            table.resize();
        });
        $('#btn-refresh').click(function () { reloadTable(); });
        $('#btn-reset').click(function () {
            $('#txt_keyword').val('');
            $('#ddl_category').val('');
            $('#ddl_status').val('');
            form.render();
        });
        form.on('submit(data-search-btn)', function () {
            reloadTable();
            return false;
        });
        wcLoading.close();

        var oneList = ["NF-edit", "NF-chapter", "NF-ware", "NF-online", "NF-offline"];
        var moreList = ["NF-delete"];
        commonTable.tableRowClick("checkbox", "currentTableFilter", "currentTableId", oneList, moreList);

        function openForm(title, url, width, height) {
            common.modalOpen({ title: title, url: url, width: width, height: height });
        }

        function getChecked() {
            return table.checkStatus('currentTableId').data;
        }

        function setStatus(id, status) {
            common.submitForm({
                url: '/InstructionalManagement/Course/SetStatus',
                param: { keyValue: id, status: status },
                close: false,
                success: function () { reloadTable(); }
            });
        }

        table.on('toolbar(currentTableFilter)', function (obj) {
            var data = getChecked();
            var id = data.length > 0 ? data[0].F_Id : null;
            if (obj.event === 'add') {
                openForm("新增课程", "/InstructionalManagement/Course/Form", "700px", "600px");
            }
            else if (obj.event === 'edit') {
                if (data.length == 0) { common.modalMsg("未选中数据", "warning"); return false; }
                if (data.length > 1) { common.modalMsg("只能选择一条数据进行编辑", "warning"); return false; }
                openForm("修改课程", "/InstructionalManagement/Course/Form?keyValue=" + id, "700px", "600px");
            }
            else if (obj.event === 'chapter') {
                if (data.length == 0) { common.modalMsg("未选中数据", "warning"); return false; }
                if (data.length > 1) { common.modalMsg("只能选择一条数据", "warning"); return false; }
                common.modalOpen({
                    title: "章节管理 - " + data[0].F_Name,
                    url: "/InstructionalManagement/Course/Chapter?courseId=" + id,
                    width: "1020px",
                    height: "640px",
                    btn: []
                });
            }
            else if (obj.event === 'ware') {
                if (data.length == 0) { common.modalMsg("未选中数据", "warning"); return false; }
                if (data.length > 1) { common.modalMsg("只能选择一条数据", "warning"); return false; }
                common.modalOpen({
                    title: "资料管理 - " + data[0].F_Name,
                    url: "/InstructionalManagement/Course/Ware?courseId=" + id,
                    width: "860px",
                    height: "600px",
                    btn: []
                });
            }
            else if (obj.event === 'online') {
                if (data.length == 0) { common.modalMsg("未选中数据", "warning"); return false; }
                if (data.length > 1) { common.modalMsg("只能选择一条数据", "warning"); return false; }
                setStatus(id, 1);
            }
            else if (obj.event === 'offline') {
                if (data.length == 0) { common.modalMsg("未选中数据", "warning"); return false; }
                if (data.length > 1) { common.modalMsg("只能选择一条数据", "warning"); return false; }
                setStatus(id, 0);
            }
            else if (obj.event === 'delete') {
                if (data.length == 0) { common.modalMsg("未选中数据", "warning"); return false; }
                var ids = [];
                for (var i = 0; i < data.length; i++) { ids.push(data[i].F_Id); }
                common.deleteForm({
                    url: "/InstructionalManagement/Course/DeleteForm",
                    param: { keyValue: ids.join(',') },
                    success: function () { reloadTable(); }
                });
            }
            else if (obj.event === 'TABLE_SEARCH') {
                var _that = $("#searchField");
                if (_that.hasClass("layui-hide")) { _that.removeClass('layui-hide'); } else { _that.addClass('layui-hide'); }
                table.resize();
            }
            return false;
        });

        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            if (obj.event === 'delete') {
                common.deleteForm({
                    url: "/InstructionalManagement/Course/DeleteForm",
                    param: { keyValue: data.F_Id },
                    success: function () { obj.del(); }
                });
            }
            else if (obj.event === 'edit') {
                openForm("修改课程", "/InstructionalManagement/Course/Form?keyValue=" + data.F_Id, "700px", "600px");
            }
            else if (obj.event === 'chapter') {
                common.modalOpen({
                    title: "章节管理 - " + data.F_Name,
                    url: "/InstructionalManagement/Course/Chapter?courseId=" + data.F_Id,
                    width: "1020px",
                    height: "640px",
                    btn: []
                });
            }
            else if (obj.event === 'ware') {
                common.modalOpen({
                    title: "资料管理 - " + data.F_Name,
                    url: "/InstructionalManagement/Course/Ware?courseId=" + data.F_Id,
                    width: "860px",
                    height: "600px",
                    btn: []
                });
            }
            return false;
        });
    });
</script>
