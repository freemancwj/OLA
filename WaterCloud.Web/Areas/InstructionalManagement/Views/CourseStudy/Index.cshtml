@{
    ViewBag.Title = "在线学习";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<style>
    .course-cards { display: flex; flex-wrap: wrap; gap: 16px; padding: 15px; }
    .course-card { width: 260px; background: #fff; border-radius: 6px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.12); cursor: pointer; transition: box-shadow .2s; }
    .course-card:hover { box-shadow: 0 4px 12px rgba(0,0,0,.2); }
    .course-cover { width: 100%; height: 140px; object-fit: cover; background: #f0f0f0; display: block; }
    .course-cover-empty { width: 100%; height: 140px; background: #e2e2e2; display: flex; align-items: center; justify-content: center; color: #999; font-size: 14px; }
    .course-body { padding: 10px 12px 12px; }
    .course-name { font-size: 15px; font-weight: bold; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .course-meta { font-size: 12px; color: #888; margin-top: 6px; }
    .course-progress { margin-top: 8px; }
    .course-empty { padding: 60px; text-align: center; color: #999; width: 100%; }
</style>
<div class="layuimini-container">
    <div class="layuimini-main">
        <fieldset class="table-search-fieldset" id="searchField">
            <div>
                <form class="layui-form layui-form-pane">
                    <div class="layui-form-item" style="margin-bottom:0;">
                        <div class="layui-inline">
                            <label class="layui-form-label">关键字:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="txt_keyword" name="txt_keyword" autocomplete="off" class="layui-input" placeholder="课程/分类/教师">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">分类:</label>
                            <div class="layui-input-inline">
                                <select id="ddl_category" name="ddl_category" lay-search>
                                    <option value="">全部分类</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn">
                                <i class="layui-icon">&#xe615;</i> 搜 索
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>
        <div id="courseCards" class="course-cards"></div>
    </div>
</div>
<script>
    layui.use(['jquery', 'form', 'element', 'common'], function () {
        var $ = layui.jquery,
            form = layui.form,
            element = layui.element,
            common = layui.common;

        function loadOptions() {
            common.ajax({
                url: '/InstructionalManagement/CourseCategory/GetTreeSelectJson', async: false,
                success: function (data) {
                    var html = '<option value="">全部分类</option>';
                    $.each(data, function (i, item) { html += '<option value="' + item.F_Id + '">' + item.F_Name + '</option>'; });
                    $('#ddl_category').html(html);
                }
            });
            form.render('select');
        }

        function loadCards() {
            common.ajax({
                url: '/InstructionalManagement/CourseStudy/GetCardsJson',
                data: { keyword: $('#txt_keyword').val(), categoryId: $('#ddl_category').val() },
                success: function (list) {
                    renderCards(list || []);
                }
            });
        }

        function renderCards(list) {
            var $wrap = $('#courseCards').empty();
            if (list.length === 0) {
                $wrap.append('<div class="course-empty">暂无上架课程</div>');
                return;
            }
            $.each(list, function (i, item) {
                var cover = item.F_Cover
                    ? '<img class="course-cover" src="' + item.F_Cover + '" />'
                    : '<div class="course-cover-empty">暂无封面</div>';
                var html =
                    '<div class="course-card" data-id="' + item.F_Id + '">' +
                        cover +
                        '<div class="course-body">' +
                            '<div class="course-name" title="' + (item.F_Name || '') + '">' + (item.F_Name || '') + '</div>' +
                            '<div class="course-meta">' + (item.F_CategoryName || '未分类') + ' · ' + (item.F_TeacherName || '未指定教师') + ' · ' + item.LessonCount + '个课时</div>' +
                            '<div class="course-progress">' +
                                '<div class="layui-progress" lay-showpercent="true" lay-filter="prog-' + item.F_Id + '">' +
                                    '<div class="layui-progress-bar" lay-percent="' + item.ProgressPercent + '%"></div>' +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                    '</div>';
                $wrap.append(html);
            });
            element.render('progress');
            $wrap.find('.course-card').on('click', function () {
                var id = $(this).data('id');
                common.modalOpen({
                    title: '课程学习',
                    url: '/InstructionalManagement/CourseStudy/Play?courseId=' + id,
                    width: '1200px',
                    height: '92%',
                    btn: [],
                    end: function () { loadCards(); }
                });
            });
        }

        loadOptions();
        loadCards();
        wcLoading.close();

        form.on('submit(data-search-btn)', function () {
            loadCards();
            return false;
        });
    });
</script>
