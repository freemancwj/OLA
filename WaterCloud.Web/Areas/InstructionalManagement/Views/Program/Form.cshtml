@{
    ViewBag.Title = "培养方案";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'common', 'optimizeSelectOption'], function () {
        var form = layui.form,
            $ = layui.jquery,
            common = layui.common;
        var keyValue = $.request("keyValue");

        function initControl() {
            $("#F_MajorId").bindSelect({
                url: "/InstructionalManagement/Program/GetMajorListJson",
                id: "F_Id",
                text: "F_FullName",
                search: true
            });
            $("#F_CourseId").bindSelect({
                url: "/InstructionalManagement/Program/GetCourseListJson",
                id: "F_Id",
                text: "F_Name",
                search: true
            });
        }

        $(function () {
            initControl();
            if (!!keyValue) {
                common.ajax({
                    url: '/InstructionalManagement/Program/GetFormJson',
                    data: { keyValue: keyValue },
                    async: false,
                    success: function (data) {
                        $('#F_MajorId').val(data.F_MajorId);
                        $('#F_Semester').val(data.F_Semester);
                        $('#F_CourseId').val(data.F_CourseId);
                        $('#F_Credit').val(data.F_Credit);
                        $('#F_Period').val(data.F_Period);
                        $('#F_Nature').val(data.F_Nature);
                        $('#F_Remark').val(data.F_Remark);
                    }
                });
            }
            form.render();
        });
        wcLoading.close();

        //监听提交
        form.on('submit(saveBtn)', function (data) {
            common.submitForm({
                url: '/InstructionalManagement/Program/SubmitForm?keyValue=' + (keyValue || ''),
                param: data.field,
                success: function () {
                    common.parentreload('data-search-btn');
                }
            });
            return false;
        });
    });
</script>

<body>
    <div class="layuimini-container">
        <div class="layuimini-main">
            <div class="layui-form layuimini-form" lay-filter="adminform">
                <div class="layui-form-item">
                    <label class="layui-form-label required">专业</label>
                    <div class="layui-input-block">
                        <select id="F_MajorId" name="F_MajorId" lay-verify="required" lay-search>
                            <option value="">请选择专业</option>
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label required">学期</label>
                    <div class="layui-input-block">
                        <input type="text" id="F_Semester" name="F_Semester" autocomplete="off" maxlength="50" lay-verify="required" placeholder="如 2025-2026-1" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label required">课程</label>
                    <div class="layui-input-block">
                        <select id="F_CourseId" name="F_CourseId" lay-verify="required" lay-search>
                            <option value="">请选择课程</option>
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label required">学分</label>
                    <div class="layui-input-block">
                        <input type="number" id="F_Credit" name="F_Credit" step="0.5" min="0" lay-verify="required|number" autocomplete="off" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">学时</label>
                    <div class="layui-input-block">
                        <input type="number" id="F_Period" name="F_Period" min="0" lay-verify="number" autocomplete="off" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">课程性质</label>
                    <div class="layui-input-block">
                        <select id="F_Nature" name="F_Nature">
                            <option value="必修">必修</option>
                            <option value="选修">选修</option>
                            <option value="限选">限选</option>
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">备注</label>
                    <div class="layui-input-block">
                        <textarea id="F_Remark" name="F_Remark" maxlength="500" class="layui-textarea" placeholder="选填"></textarea>
                    </div>
                </div>
                <div class="layui-form-item layui-hide">
                    <button class="layui-btn site-demo-active" lay-submit id="submit" lay-filter="saveBtn">确认保存</button>
                </div>
            </div>
        </div>
    </div>
</body>
