@{
    ViewBag.Title = "选课批次";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'table', 'common', 'commonTable'], function () {
        var $ = layui.jquery,
            form = layui.form,
            table = layui.table,
            common = layui.common,
            commonTable = layui.commonTable;

        wcLoading.close();

        commonTable.rendertable({
            elem: '#currentTableId',
            id: 'currentTableId',
            url: '/InstructionalManagement/ElectiveRound/GetGridJson',
            cols: [[
                { type: 'checkbox', fixed: 'left' },
                { field: 'F_Semester', title: '学期', width: 130, sort: true },
                { field: 'F_Name', title: '批次名称', width: 180, sort: true },
                {
                    field: 'F_StartTime', title: '开始时间', width: 170,
                    templet: function (d) { return d.F_StartTime ? String(d.F_StartTime).replace(/\//g, '-').substring(0, 16) : ''; }
                },
                {
                    field: 'F_EndTime', title: '结束时间', width: 170,
                    templet: function (d) { return d.F_EndTime ? String(d.F_EndTime).replace(/\//g, '-').substring(0, 16) : ''; }
                },
                {
                    field: 'F_Status', title: '当前状态', width: 100, align: 'center',
                    templet: function (d) {
                        var now = new Date();
                        var st = d.F_StartTime ? new Date(String(d.F_StartTime).replace(/\//g, '-')) : null;
                        var et = d.F_EndTime ? new Date(String(d.F_EndTime).replace(/\//g, '-')) : null;
                        if (st && et && now >= st && now <= et) { return '<span class="layui-badge layui-bg-green">开放中</span>'; }
                        if (st && now < st) { return '<span class="layui-badge layui-bg-blue">未开始</span>'; }
                        return '<span class="layui-badge">已结束</span>';
                    }
                },
                { field: 'F_Remark', title: '备注', minWidth: 140 },
                { title: '操作', width: 130, toolbar: '#currentTableBar', align: 'center', fixed: 'right' }
            ]]
        });

        //监听搜索
        form.on('submit(data-search-btn)', function (data) {
            commonTable.reloadtable({
                elem: 'currentTableId',
                curr: 1,
                where: { keyword: $('#txt_keyword').val() }
            });
            return false;
        });

        //行点击事件监听，控制按钮显示
        var oneList = ["NF-edit"];//选择1条显示
        var moreList = ["NF-delete"];//选中多条显示
        commonTable.tableRowClick("checkbox", "currentTableFilter", "currentTableId", oneList, moreList);

        //工具栏事件
        table.on('toolbar(currentTableFilter)', function (obj) {
            var checkStatus = table.checkStatus('currentTableId');
            if (obj.event === 'add') {
                common.modalOpen({
                    title: '新增选课批次',
                    url: '/InstructionalManagement/ElectiveRound/Form',
                    width: '500px',
                    height: '480px'
                });
            }
            else if (obj.event === 'delete') {
                if (checkStatus.data.length == 0) {
                    common.modalMsg('请选择需要删除的数据', 'warning');
                    return false;
                }
                var ids = [];
                for (var i = 0; i < checkStatus.data.length; i++) {
                    ids.push(checkStatus.data[i].F_Id);
                }
                common.deleteForm({
                    url: '/InstructionalManagement/ElectiveRound/DeleteForm',
                    param: { keyValue: ids.join(',') },
                    success: function () {
                        commonTable.reloadtable({ elem: 'currentTableId' });
                    }
                });
            }
        });

        //行操作事件
        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            if (obj.event === 'edit') {
                common.modalOpen({
                    title: '修改选课批次',
                    url: '/InstructionalManagement/ElectiveRound/Form?keyValue=' + data.F_Id,
                    width: '500px',
                    height: '480px'
                });
            }
            else if (obj.event === 'delete') {
                common.deleteForm({
                    url: '/InstructionalManagement/ElectiveRound/DeleteForm',
                    param: { keyValue: data.F_Id },
                    success: function () {
                        commonTable.reloadtable({ elem: 'currentTableId' });
                    }
                });
            }
        });
    });
</script>

<div class="layuimini-container">
    <div class="layuimini-main">
        <fieldset class="table-search-fieldset">
            <legend>搜索信息</legend>
            <div style="margin: 10px 10px 10px 10px">
                <form class="layui-form layui-form-pane">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">关键字:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="txt_keyword" name="txt_keyword" autocomplete="off" class="layui-input" placeholder="批次名称/学期">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>
        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container">
                <button class="layui-btn layui-btn-sm" lay-event="add" id="NF-add" name="NF-add" authorize><i class="layui-icon">&#xe654;</i>新增批次</button>
                <button class="layui-btn layui-btn-sm layui-btn-danger" lay-event="delete" id="NF-delete" name="NF-delete" authorize><i class="layui-icon">&#xe640;</i>删除</button>
            </div>
        </script>
        <script type="text/html" id="currentTableBar">
            <a class="layui-btn layui-btn-xs layui-btn-warm" lay-event="edit" id="NF-edit" authorize><i class="layui-icon">&#xe642;</i>修改</a>
            <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="delete" id="NF-delete" authorize><i class="layui-icon">&#xe640;</i>删除</a>
        </script>
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
    </div>
</div>
