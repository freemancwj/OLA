@{
    ViewBag.Title = "选课设置";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'table', 'common', 'commonTable', 'optimizeSelectOption'], function () {
        var $ = layui.jquery,
            form = layui.form,
            table = layui.table,
            common = layui.common,
            commonTable = layui.commonTable;

        wcLoading.close();
        var WEEK = ['', '周一', '周二', '周三', '周四', '周五', '周六', '周日'];

        $("#F_RoundId").bindSelect({
            url: "/InstructionalManagement/ElectiveCourse/GetRoundListJson",
            id: "F_Id",
            text: "F_Name",
            search: true
        });

        commonTable.rendertable({
            elem: '#currentTableId',
            id: 'currentTableId',
            url: '/InstructionalManagement/ElectiveCourse/GetGridJson',
            cols: [[
                { type: 'checkbox', fixed: 'left' },
                { field: 'F_RoundName', title: '批次', width: 140 },
                { field: 'F_CourseName', title: '课程', width: 150, sort: true },
                { field: 'F_TeacherName', title: '授课教师', width: 100 },
                { field: 'F_Capacity', title: '容量', width: 80, align: 'center' },
                {
                    field: 'F_SelectedCount', title: '已选/剩余', width: 110, align: 'center',
                    templet: function (d) {
                        var left = (d.F_Capacity || 0) - (d.F_SelectedCount || 0);
                        var color = left <= 0 ? 'layui-bg-red' : 'layui-bg-green';
                        return '<span class="layui-badge ' + color + '">' + d.F_SelectedCount + ' / ' + (left > 0 ? left : 0) + '</span>';
                    }
                },
                { title: '上课时间', width: 130, align: 'center', templet: function (d) { return d.F_WeekDay ? WEEK[d.F_WeekDay] + ' 第' + d.F_Section + '节' : ''; } },
                { field: 'F_ClassroomName', title: '教室', width: 110 },
                { title: '操作', width: 130, toolbar: '#currentTableBar', align: 'center', fixed: 'right' }
            ]]
        });

        //监听搜索
        form.on('submit(data-search-btn)', function (data) {
            commonTable.reloadtable({
                elem: 'currentTableId',
                curr: 1,
                where: {
                    roundId: $('#F_RoundId').val(),
                    keyword: $('#txt_keyword').val()
                }
            });
            return false;
        });

        //行点击事件监听，控制按钮显示
        var oneList = ["NF-edit"];//选择1条显示
        var moreList = ["NF-delete"];//选中多条显示
        commonTable.tableRowClick("checkbox", "currentTableFilter", "currentTableId", oneList, moreList);

        //工具栏事件
        table.on('toolbar(currentTableFilter)', function (obj) {
            var checkStatus = table.checkStatus('currentTableId');
            if (obj.event === 'add') {
                common.modalOpen({
                    title: '新增可选课程',
                    url: '/InstructionalManagement/ElectiveCourse/Form',
                    width: '500px',
                    height: '600px'
                });
            }
            else if (obj.event === 'delete') {
                if (checkStatus.data.length == 0) {
                    common.modalMsg('请选择需要删除的数据', 'warning');
                    return false;
                }
                var ids = [];
                for (var i = 0; i < checkStatus.data.length; i++) {
                    ids.push(checkStatus.data[i].F_Id);
                }
                common.deleteForm({
                    url: '/InstructionalManagement/ElectiveCourse/DeleteForm',
                    param: { keyValue: ids.join(',') },
                    success: function () {
                        commonTable.reloadtable({ elem: 'currentTableId' });
                    }
                });
            }
        });

        //行操作事件
        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            if (obj.event === 'edit') {
                common.modalOpen({
                    title: '修改可选课程',
                    url: '/InstructionalManagement/ElectiveCourse/Form?keyValue=' + data.F_Id,
                    width: '500px',
                    height: '600px'
                });
            }
            else if (obj.event === 'delete') {
                common.deleteForm({
                    url: '/InstructionalManagement/ElectiveCourse/DeleteForm',
                    param: { keyValue: data.F_Id },
                    success: function () {
                        commonTable.reloadtable({ elem: 'currentTableId' });
                    }
                });
            }
        });
    });
</script>

<div class="layuimini-container">
    <div class="layuimini-main">
        <fieldset class="table-search-fieldset">
            <legend>搜索信息</legend>
            <div style="margin: 10px 10px 10px 10px">
                <form class="layui-form layui-form-pane">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">批次:</label>
                            <div class="layui-input-inline">
                                <select id="F_RoundId" name="F_RoundId" lay-search>
                                    <option value="">全部批次</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">关键字:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="txt_keyword" name="txt_keyword" autocomplete="off" class="layui-input" placeholder="课程/教师">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>
        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container">
                <button class="layui-btn layui-btn-sm" lay-event="add" id="NF-add" name="NF-add" authorize><i class="layui-icon">&#xe654;</i>新增可选课程</button>
                <button class="layui-btn layui-btn-sm layui-btn-danger" lay-event="delete" id="NF-delete" name="NF-delete" authorize><i class="layui-icon">&#xe640;</i>删除</button>
            </div>
        </script>
        <script type="text/html" id="currentTableBar">
            <a class="layui-btn layui-btn-xs layui-btn-warm" lay-event="edit" id="NF-edit" authorize><i class="layui-icon">&#xe642;</i>修改</a>
            <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="delete" id="NF-delete" authorize><i class="layui-icon">&#xe640;</i>删除</a>
        </script>
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
    </div>
</div>
