@{
    ViewBag.Title = "成绩统计";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'table', 'common', 'commonTable', 'optimizeSelectOption'], function () {
        var $ = layui.jquery,
            form = layui.form,
            table = layui.table,
            common = layui.common,
            commonTable = layui.commonTable;

        wcLoading.close();

        $("#F_Semester").bindSelect({
            url: "/InstructionalManagement/ScoreStat/GetSemesterListJson",
            id: "F_Semester",
            text: "F_Semester"
        });
        $("#F_ClassId").bindSelect({
            url: "/InstructionalManagement/ScoreStat/GetClassListJson",
            id: "F_Id",
            text: "F_FullName",
            search: true
        });
        $("#F_CourseId").bindSelect({
            url: "/InstructionalManagement/ScoreStat/GetCourseListJson",
            id: "F_Id",
            text: "F_Name",
            search: true
        });

        commonTable.rendertable({
            elem: '#currentTableId',
            id: 'currentTableId',
            url: '/InstructionalManagement/ScoreStat/GetGridJson',
            page: false,
            limit: 9999,
            search: false,
            cols: [[
                { field: 'F_Semester', title: '学期', width: 130, sort: true },
                { field: 'F_CourseName', title: '课程', width: 150, sort: true },
                { field: 'F_ClassName', title: '班级', width: 140 },
                { field: 'F_TotalCount', title: '人数', width: 80, align: 'center', sort: true },
                { field: 'F_AvgScore', title: '平均分', width: 90, align: 'center', sort: true },
                { field: 'F_MaxScore', title: '最高分', width: 90, align: 'center' },
                { field: 'F_MinScore', title: '最低分', width: 90, align: 'center' },
                {
                    field: 'F_PassRate', title: '及格率', width: 100, align: 'center', sort: true,
                    templet: function (d) {
                        if (!d.F_TotalCount) return '-';
                        var rate = (d.F_PassCount * 100.0 / d.F_TotalCount);
                        var color = rate >= 60 ? 'layui-bg-green' : 'layui-bg-orange';
                        return '<span class="layui-badge ' + color + '">' + rate.toFixed(1) + '%</span>';
                    }
                },
                {
                    field: 'F_ExcellentRate', title: '优秀率(≥90)', width: 110, align: 'center',
                    templet: function (d) {
                        if (!d.F_TotalCount) return '-';
                        return (d.F_ExcellentCount * 100.0 / d.F_TotalCount).toFixed(1) + '%';
                    }
                },
                { field: 'F_Seg90', title: '90-100', width: 85, align: 'center' },
                { field: 'F_Seg80', title: '80-89', width: 85, align: 'center' },
                { field: 'F_Seg70', title: '70-79', width: 85, align: 'center' },
                { field: 'F_Seg60', title: '60-69', width: 85, align: 'center' },
                {
                    field: 'F_SegFail', title: '60以下', width: 85, align: 'center',
                    templet: function (d) {
                        return d.F_SegFail > 0 ? '<span style="color:red;font-weight:bold;">' + d.F_SegFail + '</span>' : '0';
                    }
                }
            ]]
        });

        //监听搜索
        form.on('submit(data-search-btn)', function (data) {
            commonTable.reloadtable({
                elem: 'currentTableId',
                curr: 1,
                where: {
                    semester: $('#F_Semester').val(),
                    courseId: $('#F_CourseId').val(),
                    classId: $('#F_ClassId').val()
                }
            });
            return false;
        });
    });
</script>

<div class="layuimini-container">
    <div class="layuimini-main">
        <fieldset class="table-search-fieldset">
            <legend>搜索信息</legend>
            <div style="margin: 10px 10px 10px 10px">
                <form class="layui-form layui-form-pane">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">学期:</label>
                            <div class="layui-input-inline">
                                <select id="F_Semester" name="F_Semester">
                                    <option value="">全部学期</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">课程:</label>
                            <div class="layui-input-inline">
                                <select id="F_CourseId" name="F_CourseId" lay-search>
                                    <option value="">全部课程</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">班级:</label>
                            <div class="layui-input-inline">
                                <select id="F_ClassId" name="F_ClassId" lay-search>
                                    <option value="">全部班级</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>
        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container">
                <span style="color:#888;font-size:12px;">仅统计审核通过的成绩；表格支持右上角筛选/导出/打印</span>
            </div>
        </script>
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
    </div>
</div>
