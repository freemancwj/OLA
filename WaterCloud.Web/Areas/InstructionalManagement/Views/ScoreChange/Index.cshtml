@{
    ViewBag.Title = "成绩修改申请";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'table', 'common', 'commonTable', 'optimizeSelectOption'], function () {
        var $ = layui.jquery,
            form = layui.form,
            table = layui.table,
            common = layui.common,
            commonTable = layui.commonTable;

        wcLoading.close();

        //状态徽章
        function statusBadge(v) {
            if (v === 1) return '<span class="layui-badge layui-bg-green">已通过</span>';
            if (v === 2) return '<span class="layui-badge layui-bg-red">已拒绝</span>';
            return '<span class="layui-badge layui-bg-blue">待审批</span>';
        }

        commonTable.rendertable({
            elem: '#currentTableId',
            id: 'currentTableId',
            url: '/InstructionalManagement/ScoreChange/GetGridJson',
            cols: [[
                { type: 'checkbox', fixed: 'left' },
                { field: 'F_StudentName', title: '学生', width: 100, sort: true },
                { field: 'F_Account', title: '账号', width: 110, sort: true },
                { field: 'F_ClassName', title: '班级', width: 130, sort: true },
                { field: 'F_CourseName', title: '课程', width: 120, sort: true },
                { field: 'F_ScoreTypeName', title: '成绩类型', width: 100 },
                { field: 'F_OldScore', title: '原分数', width: 80, align: 'center' },
                { field: 'F_NewScore', title: '新分数', width: 80, align: 'center' },
                { field: 'F_Reason', title: '申请原因', minWidth: 150 },
                { field: 'F_Status', title: '状态', width: 90, align: 'center', templet: function (d) { return statusBadge(d.F_Status); } },
                { field: 'F_AuditUserName', title: '审批人', width: 90 },
                { field: 'F_CreatorTime', title: '申请时间', width: 150, sort: true },
                { title: '操作', width: 130, toolbar: '#currentTableBar', fixed: 'right' }
            ]]
        });

        //监听搜索
        form.on('submit(data-search-btn)', function (data) {
            commonTable.reloadtable({
                elem: 'currentTableId',
                curr: 1,
                where: { keyword: $('#txt_keyword').val(), status: $('#ddl_status').val() }
            });
            return false;
        });

        //行操作事件
        table.on('tool(currentTableId)', function (obj) {
            var data = obj.data;
            if (obj.event === 'audit') {
                common.modalOpen({
                    title: '审批申请',
                    url: '/InstructionalManagement/ScoreChange/AuditForm?keyValue=' + data.F_Id,
                    width: '560px',
                    height: '580px'
                });
            }
            else if (obj.event === 'delete') {
                common.deleteForm({
                    url: '/InstructionalManagement/ScoreChange/DeleteForm',
                    param: { keyValue: data.F_Id },
                    success: function () {
                        commonTable.reloadtable({ elem: 'currentTableId' });
                    }
                });
            }
        });

        //工具栏事件
        table.on('toolbar(currentTableId)', function (obj) {
            var checkStatus = table.checkStatus('currentTableId');
            if (obj.event === 'add') {
                common.modalOpen({
                    title: '新增申请',
                    url: '/InstructionalManagement/ScoreChange/Form',
                    width: '500px',
                    height: '430px'
                });
            }
            else if (obj.event === 'delete') {
                if (checkStatus.data.length == 0) {
                    common.modalMsg('请选择需要删除的数据', 'warning');
                    return false;
                }
                var ids = [];
                for (var i = 0; i < checkStatus.data.length; i++) {
                    ids.push(checkStatus.data[i].F_Id);
                }
                common.deleteForm({
                    url: '/InstructionalManagement/ScoreChange/DeleteForm',
                    param: { keyValue: ids.join(',') },
                    success: function () {
                        commonTable.reloadtable({ elem: 'currentTableId' });
                    }
                });
            }
        });
    });
</script>

<div class="layuimini-container">
    <div class="layuimini-main">
        <fieldset class="table-search-fieldset">
            <legend>搜索信息</legend>
            <div style="margin: 10px 10px 10px 10px">
                <form class="layui-form layui-form-pane">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">关键字:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="txt_keyword" name="txt_keyword" autocomplete="off" class="layui-input" placeholder="学生/账号/课程">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">状态:</label>
                            <div class="layui-input-inline">
                                <select id="ddl_status" name="ddl_status">
                                    <option value="">全部</option>
                                    <option value="0">待审批</option>
                                    <option value="1">已通过</option>
                                    <option value="2">已拒绝</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>
        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container">
                <button class="layui-btn layui-btn-sm" lay-event="add" id="NF-add" authorize><i class="layui-icon">&#xe654;</i>新增申请</button>
                <button class="layui-btn layui-btn-sm layui-btn-danger" lay-event="delete" id="NF-delete" authorize><i class="layui-icon">&#xe640;</i>删除</button>
            </div>
        </script>
        <script type="text/html" id="currentTableBar">
            {{# if(d.F_Status === 0){ }}
            <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="audit" id="NF-audit" authorize><i class="layui-icon">&#xe6b2;</i>审批</a>
            {{# } }}
            <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="delete" id="NF-delete" authorize><i class="layui-icon">&#xe640;</i>删除</a>
        </script>
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableId"></table>
    </div>
</div>
