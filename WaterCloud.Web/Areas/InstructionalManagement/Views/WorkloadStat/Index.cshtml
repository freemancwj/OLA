@{
    ViewBag.Title = "教师工作量统计";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'table', 'common', 'commonTable', 'optimizeSelectOption'], function () {
        var $ = layui.jquery,
            form = layui.form,
            table = layui.table,
            common = layui.common,
            commonTable = layui.commonTable;

        wcLoading.close();

        $("#F_Semester").bindSelect({
            url: "/InstructionalManagement/WorkloadStat/GetSemesterListJson",
            id: "F_Semester",
            text: "F_Semester"
        });

        commonTable.rendertable({
            elem: '#currentTableId',
            id: 'currentTableId',
            url: '/InstructionalManagement/WorkloadStat/GetGridJson',
            page: false,
            limit: 9999,
            search: false,
            cols: [[
                { field: 'F_TeacherName', title: '教师', width: 120, sort: true },
                { field: 'F_Account', title: '账号', width: 120 },
                { field: 'F_CourseCount', title: '授课门数', width: 110, align: 'center', sort: true },
                { field: 'F_LessonCount', title: '周课时数', width: 110, align: 'center', sort: true },
                { field: 'F_InvigilateCount', title: '监考次数(累计)', width: 140, align: 'center', sort: true },
                {
                    field: 'F_Total', title: '工作量合计', width: 120, align: 'center', sort: true,
                    templet: function (d) {
                        var total = (d.F_LessonCount || 0) + (d.F_InvigilateCount || 0);
                        return '<span style="font-weight:bold;">' + total + '</span>';
                    }
                }
            ]]
        });

        //监听搜索
        form.on('submit(data-search-btn)', function (data) {
            commonTable.reloadtable({
                elem: 'currentTableId',
                curr: 1,
                where: {
                    semester: $('#F_Semester').val()
                }
            });
            return false;
        });
    });
</script>

<div class="layuimini-container">
    <div class="layuimini-main">
        <fieldset class="table-search-fieldset">
            <legend>搜索信息</legend>
            <div style="margin: 10px 10px 10px 10px">
                <form class="layui-form layui-form-pane">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">学期:</label>
                            <div class="layui-input-inline">
                                <select id="F_Semester" name="F_Semester">
                                    <option value="">全部学期</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>
        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container">
                <span style="color:#888;font-size:12px;">周课时数按课表统计（受学期筛选）；监考次数含考务/补考/清考的主副监考，累计统计；表格支持右上角导出/打印</span>
            </div>
        </script>
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
    </div>
</div>
