@{
    ViewBag.Title = "选课统计";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'table', 'common', 'commonTable', 'optimizeSelectOption'], function () {
        var $ = layui.jquery,
            form = layui.form,
            table = layui.table,
            common = layui.common,
            commonTable = layui.commonTable;

        var WEEK = ['', '周一', '周二', '周三', '周四', '周五', '周六', '周日'];

        wcLoading.close();

        $("#F_RoundId").bindSelect({
            url: "/InstructionalManagement/ElectiveStat/GetRoundListJson",
            id: "F_Id",
            text: "F_Name",
            search: true
        });

        commonTable.rendertable({
            elem: '#currentTableId',
            id: 'currentTableId',
            url: '/InstructionalManagement/ElectiveStat/GetGridJson',
            page: false,
            limit: 9999,
            search: false,
            cols: [[
                { field: 'F_RoundName', title: '选课批次', width: 160, sort: true },
                { field: 'F_CourseName', title: '课程', width: 150, sort: true },
                { field: 'F_TeacherName', title: '授课教师', width: 100 },
                {
                    field: 'F_WeekDay', title: '上课时间', width: 110, align: 'center',
                    templet: function (d) {
                        if (!d.F_WeekDay) return '-';
                        return (WEEK[d.F_WeekDay] || '') + ' 第' + (d.F_Section || '') + '节';
                    }
                },
                { field: 'F_ClassroomName', title: '教室', width: 120 },
                { field: 'F_Capacity', title: '容量', width: 80, align: 'center' },
                { field: 'F_SelectedCount', title: '已选', width: 80, align: 'center', sort: true },
                {
                    field: 'F_Remain', title: '剩余', width: 80, align: 'center',
                    templet: function (d) {
                        if (d.F_Capacity == null) return '不限';
                        var remain = d.F_Capacity - d.F_SelectedCount;
                        return remain > 0 ? String(remain) : '<span style="color:red;font-weight:bold;">0</span>';
                    }
                },
                {
                    field: 'F_UseRate', title: '选课率', width: 110, align: 'center', sort: true,
                    templet: function (d) {
                        if (!d.F_Capacity) return '-';
                        var rate = d.F_SelectedCount * 100.0 / d.F_Capacity;
                        var color = rate >= 100 ? 'layui-bg-red' : (rate >= 80 ? 'layui-bg-orange' : 'layui-bg-green');
                        return '<span class="layui-badge ' + color + '">' + rate.toFixed(1) + '%</span>';
                    }
                }
            ]]
        });

        //监听搜索
        form.on('submit(data-search-btn)', function (data) {
            commonTable.reloadtable({
                elem: 'currentTableId',
                curr: 1,
                where: {
                    roundId: $('#F_RoundId').val()
                }
            });
            return false;
        });
    });
</script>

<div class="layuimini-container">
    <div class="layuimini-main">
        <fieldset class="table-search-fieldset">
            <legend>搜索信息</legend>
            <div style="margin: 10px 10px 10px 10px">
                <form class="layui-form layui-form-pane">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">选课批次:</label>
                            <div class="layui-input-inline">
                                <select id="F_RoundId" name="F_RoundId" lay-search>
                                    <option value="">全部批次</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>
        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container">
                <span style="color:#888;font-size:12px;">按课程班次统计选课人数与容量使用情况；表格支持右上角导出/打印</span>
            </div>
        </script>
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
    </div>
</div>
