@{
    ViewBag.Title = "成绩管理";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<div class="layuimini-container">
    <div class="layuimini-main">
        <div class="layui-btn-group">
            <button id="btn-expand" type="button" class="layui-btn layui-btn-primary layui-btn-sm">
                <i class="layui-icon layui-icon-spread-left"></i> 展开搜索
            </button>
            <button id="btn-refresh" type="button" class="layui-btn layui-btn-primary layui-btn-sm">
                <i class="layui-icon layui-icon-refresh"></i> 刷新
            </button>
        </div>
        <fieldset class="table-search-fieldset layui-hide" id="searchField">
            <div>
                <form class="layui-form layui-form-pane">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">关键字:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="txt_keyword" name="txt_keyword" autocomplete="off" class="layui-input" placeholder="学号/姓名/课程/班级">
                            </div>
                        </div>
                        <div class="layui-inline" id="searchClassWrap">
                            <label class="layui-form-label">班级:</label>
                            <div class="layui-input-inline">
                                <select id="ddl_class" name="ddl_class" lay-search lay-filter="ddl_class">
                                    <option value="">全部班级</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">课程:</label>
                            <div class="layui-input-inline">
                                <select id="ddl_course" name="ddl_course" lay-search lay-filter="ddl_course">
                                    <option value="">全部课程</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">成绩类型:</label>
                            <div class="layui-input-inline">
                                <select id="ddl_scoreType" name="ddl_scoreType" lay-search>
                                    <option value="">全部类型</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">学期:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="txt_semester" name="txt_semester" autocomplete="off" class="layui-input" placeholder="如 2025-2026-1">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">成绩范围:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="txt_minScore" name="txt_minScore" autocomplete="off" class="layui-input" placeholder="最低分">
                            </div>
                            <div class="layui-form-mid">-</div>
                            <div class="layui-input-inline">
                                <input type="text" id="txt_maxScore" name="txt_maxScore" autocomplete="off" class="layui-input" placeholder="最高分">
                            </div>
                        </div>
                        <div class="layui-inline" id="searchAuditWrap">
                            <label class="layui-form-label">审核状态:</label>
                            <div class="layui-input-inline">
                                <select id="ddl_auditStatus" name="ddl_auditStatus">
                                    <option value="">全部</option>
                                    <option value="0">待审核</option>
                                    <option value="1">已通过</option>
                                    <option value="2">已退回</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn">
                                <i class="layui-icon">&#xe615;</i> 搜 索
                            </button>
                            <button type="button" class="layui-btn layui-btn-primary" id="btn-reset">
                                <i class="layui-icon">&#xe666;</i> 重 置
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>
        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container" id="toolbar">
                <button id="NF-batch" name="NF-batch" authorize class="layui-btn layui-btn-sm layui-btn-normal" lay-event="batch"><i class="layui-icon">&#xe65e;</i>批量录入</button>
                <button id="NF-add" name="NF-add" authorize class="layui-btn layui-btn-sm" lay-event="add"><i class="layui-icon">&#xe654;</i>新增成绩</button>
                <button id="NF-edit" name="NF-edit" authorize class="layui-btn layui-btn-sm layui-btn-warm layui-hide" lay-event="edit"><i class="layui-icon">&#xe642;</i>修改</button>
                <button id="NF-audit" name="NF-audit" authorize class="layui-btn layui-btn-sm layui-btn-primary layui-hide" lay-event="audit"><i class="layui-icon">&#xe6b1;</i>审核</button>
                <button id="NF-delete" name="NF-delete" authorize class="layui-btn layui-btn-sm layui-btn-danger layui-hide" lay-event="delete"><i class="layui-icon">&#xe640;</i>删除</button>
                <button id="NF-details" name="NF-details" authorize class="layui-btn layui-btn-sm layui-btn-normal layui-hide" lay-event="details"><i class="layui-icon">&#xe60b;</i>查看</button>
                <button id="NF-statistics" name="NF-statistics" authorize class="layui-btn layui-btn-sm layui-btn-primary" lay-event="statistics"><i class="layui-icon">&#xe65b;</i>统计分析</button>
                <button id="NF-export" name="NF-export" authorize class="layui-btn layui-btn-sm layui-btn-primary" lay-event="export"><i class="layui-icon">&#xe67d;</i>导出</button>
            </div>
        </script>
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
        <script type="text/html" id="currentTableBar">
            <a id="NF-edit" authorize class="layui-btn layui-btn-xs layui-btn-warm" lay-event="edit">修改</a>
            <a id="NF-audit" authorize class="layui-btn layui-btn-xs layui-btn-primary" lay-event="audit">审核</a>
            <a id="NF-delete" authorize class="layui-btn layui-btn-xs layui-btn-danger" lay-event="delete">删除</a>
            <a id="NF-details" authorize class="layui-btn layui-btn-xs layui-btn-normal" lay-event="details">查看</a>
        </script>
        <script type="text/html" id="auditStatusTpl">
            {{# if(d.F_AuditStatus === 1){ }}
            <span class="layui-badge layui-bg-green">已通过</span>
            {{# } else if(d.F_AuditStatus === 2){ }}
            <span class="layui-badge layui-bg-red">已退回</span>
            {{# } else { }}
            <span class="layui-badge layui-bg-orange">待审核</span>
            {{# } }}
        </script>
        <script type="text/html" id="scoreLevelTpl">
            {{# if(d.F_ScoreLevel === '优秀'){ }}
            <span class="layui-badge layui-bg-green">{{d.F_ScoreLevel}}</span>
            {{# } else if(d.F_ScoreLevel === '良好'){ }}
            <span class="layui-badge layui-bg-blue">{{d.F_ScoreLevel}}</span>
            {{# } else if(d.F_ScoreLevel === '中等'){ }}
            <span class="layui-badge layui-bg-orange">{{d.F_ScoreLevel}}</span>
            {{# } else if(d.F_ScoreLevel === '及格'){ }}
            <span class="layui-badge layui-bg-purple">{{d.F_ScoreLevel}}</span>
            {{# } else if(d.F_ScoreLevel === '不及格'){ }}
            <span class="layui-badge layui-bg-red">{{d.F_ScoreLevel}}</span>
            {{# } else { }}
            <span class="layui-badge layui-bg-gray">未评定</span>
            {{# } }}
        </script>
    </div>
</div>
<script>
    layui.use(['jquery', 'form', 'table', 'commonTable', 'common', 'optimizeSelectOption'], function () {
        var $ = layui.jquery,
            form = layui.form,
            table = layui.table,
            commonTable = layui.commonTable,
            common = layui.common;
        var canEntry = false, canAudit = false;

        function loadOptions() {
            common.ajax({
                url: '/InstructionalManagement/Scores/GetClassListJson', async: false,
                success: function (data) {
                    var html = '<option value="">全部班级</option>';
                    $.each(data, function (i, item) { html += '<option value="' + item.F_Id + '">' + item.F_FullName + '</option>'; });
                    $('#ddl_class').html(html);
                }
            });
            common.ajax({
                url: '/InstructionalManagement/Scores/GetCourseListJson', async: false,
                success: function (data) {
                    var html = '<option value="">全部课程</option>';
                    $.each(data, function (i, item) { html += '<option value="' + item.F_Id + '">' + item.F_ItemName + '</option>'; });
                    $('#ddl_course').html(html);
                }
            });
            common.ajax({
                url: '/InstructionalManagement/Scores/GetScoreTypeListJson', async: false,
                success: function (data) {
                    var html = '<option value="">全部类型</option>';
                    $.each(data, function (i, item) { html += '<option value="' + item.F_ItemCode + '">' + item.F_ItemName + '</option>'; });
                    $('#ddl_scoreType').html(html);
                }
            });
            form.render('select');
        }

        function getSearchParams() {
            return {
                keyword: $('#txt_keyword').val(),
                classId: $('#ddl_class').val(),
                courseId: $('#ddl_course').val(),
                scoreType: $('#ddl_scoreType').val(),
                semester: $('#txt_semester').val(),
                auditStatus: $('#ddl_auditStatus').val(),
                minScore: $('#txt_minScore').val(),
                maxScore: $('#txt_maxScore').val()
            };
        }

        function reloadTable() {
            commonTable.reloadtable({ elem: 'currentTableId', curr: 1, where: getSearchParams() });
        }

        loadOptions();
        currentTableBar.innerHTML = common.authorizeButtonNew(currentTableBar.innerHTML);
        toolbarDemo.innerHTML = common.authorizeButtonNew(toolbarDemo.innerHTML);

        commonTable.rendertable({
            elem: '#currentTableId',
            id: 'currentTableId',
            url: '/InstructionalManagement/Scores/GetGridJson',
            cols: [[
                { type: "checkbox", width: 50, fixed: 'left' },
                { field: 'F_Account', title: '学号', width: 120, sort: true },
                { field: 'F_RealName', title: '姓名', width: 100, sort: true },
                { field: 'F_ClassName', title: '班级', width: 130, sort: true },
                { field: 'F_CourseName', title: '课程', width: 140, sort: true },
                { field: 'F_ScoreTypeName', title: '成绩类型', width: 110, sort: true },
                {
                    field: 'F_Score', title: '分数', width: 90, sort: true,
                    templet: function (d) {
                        return d.F_Score === null || d.F_Score === undefined ? '-' : d.F_Score;
                    }
                },
                { field: 'F_ScoreLevel', title: '等级', width: 90, templet: '#scoreLevelTpl' },
                { field: 'F_Semester', title: '学期', width: 110, sort: true },
                {
                    field: 'F_ExamTime', title: '考试时间', width: 120, sort: true,
                    templet: function (d) {
                        return d.F_ExamTime ? String(d.F_ExamTime).replace(/\//g, '-').substring(0, 10) : '-';
                    }
                },
                { field: 'F_AuditStatus', title: '审核状态', width: 100, templet: '#auditStatusTpl' },
                { field: 'F_CreatorUserName', title: '录入人', width: 100 },
                { title: '操作', width: 200, toolbar: '#currentTableBar', align: "center", fixed: 'right' }
            ]]
        });

        common.ajax({
            url: '/InstructionalManagement/Scores/GetRoleJson',
            success: function (role) {
                canEntry = !!role.CanEntry;
                canAudit = !!role.CanAudit;
                if (!canEntry) {
                    $('#NF-batch,#NF-add,#NF-edit,#NF-delete').addClass('layui-hide');
                }
                if (!canAudit) {
                    $('#NF-audit').addClass('layui-hide');
                }
                if (role.IsStudent) {
                    $('#searchClassWrap,#searchAuditWrap').addClass('layui-hide');
                    $('#NF-statistics').addClass('layui-hide');
                }
            }
        });

        $('#btn-expand').click(function () {
            var $searchField = $('#searchField');
            if ($searchField.hasClass('layui-hide')) {
                $searchField.removeClass('layui-hide');
                $(this).html('<i class="layui-icon layui-icon-shrink-right"></i> 收起搜索');
            } else {
                $searchField.addClass('layui-hide');
                $(this).html('<i class="layui-icon layui-icon-spread-left"></i> 展开搜索');
            }
            table.resize();
        });
        $('#btn-refresh').click(function () { reloadTable(); });
        $('#btn-reset').click(function () {
            $('#txt_keyword').val('');
            $('#ddl_class').val('');
            $('#ddl_course').val('');
            $('#ddl_scoreType').val('');
            $('#txt_semester').val('');
            $('#ddl_auditStatus').val('');
            $('#txt_minScore').val('');
            $('#txt_maxScore').val('');
            form.render();
        });
        form.on('submit(data-search-btn)', function () {
            reloadTable();
            return false;
        });
        wcLoading.close();

        var oneList = ["NF-edit", "NF-details"];
        var moreList = ["NF-delete", "NF-audit"];
        commonTable.tableRowClick("checkbox", "currentTableFilter", "currentTableId", oneList, moreList);

        function openForm(title, url, width, height) {
            common.modalOpen({ title: title, url: url, width: width, height: height });
        }

        function getChecked() {
            return table.checkStatus('currentTableId').data;
        }

        table.on('toolbar(currentTableFilter)', function (obj) {
            var data = getChecked();
            var id = data.length > 0 ? data[0].F_Id : null;
            if (obj.event === 'add') {
                if (!canEntry) { common.modalMsg("没有录入成绩的权限", "warning"); return false; }
                openForm("新增成绩", "/InstructionalManagement/Scores/Form", "700px", "620px");
            }
            else if (obj.event === 'batch') {
                if (!canEntry) { common.modalMsg("没有录入成绩的权限", "warning"); return false; }
                openForm("批量录入成绩", "/InstructionalManagement/Scores/BatchForm", "980px", "700px");
            }
            else if (obj.event === 'edit') {
                if (data.length == 0) { common.modalMsg("未选中数据", "warning"); return false; }
                if (data.length > 1) { common.modalMsg("只能选择一条数据进行编辑", "warning"); return false; }
                openForm("修改成绩", "/InstructionalManagement/Scores/Form?keyValue=" + id, "700px", "620px");
            }
            else if (obj.event === 'audit') {
                if (!canAudit) { common.modalMsg("没有审核权限", "warning"); return false; }
                if (data.length == 0) { common.modalMsg("未选中数据", "warning"); return false; }
                var ids = [];
                for (var i = 0; i < data.length; i++) { ids.push(data[i].F_Id); }
                openForm("成绩审核", "/InstructionalManagement/Scores/AuditForm?keyValue=" + ids.join(','), "620px", "560px");
            }
            else if (obj.event === 'delete') {
                if (data.length == 0) { common.modalMsg("未选中数据", "warning"); return false; }
                var ids = [];
                for (var i = 0; i < data.length; i++) { ids.push(data[i].F_Id); }
                common.deleteForm({
                    url: "/InstructionalManagement/Scores/DeleteForm",
                    param: { keyValue: ids.join(',') },
                    success: function () { reloadTable(); }
                });
            }
            else if (obj.event === 'details') {
                if (data.length == 0) { common.modalMsg("未选中数据", "warning"); return false; }
                if (data.length > 1) { common.modalMsg("只能选择一条数据进行查看", "warning"); return false; }
                common.modalOpen({ title: "成绩详情", url: "/InstructionalManagement/Scores/Details?keyValue=" + id, width: "660px", height: "620px", btn: [] });
            }
            else if (obj.event === 'statistics') {
                openForm("成绩统计分析", "/InstructionalManagement/Scores/Statistics", "1180px", "700px");
            }
            else if (obj.event === 'export') {
                window.open('/InstructionalManagement/Scores/ExportExcel?' + $.param(getSearchParams()));
            }
            else if (obj.event === 'TABLE_SEARCH') {
                var _that = $("#searchField");
                if (_that.hasClass("layui-hide")) { _that.removeClass('layui-hide'); } else { _that.addClass('layui-hide'); }
                table.resize();
            }
            return false;
        });

        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            if (obj.event === 'delete') {
                common.deleteForm({
                    url: "/InstructionalManagement/Scores/DeleteForm",
                    param: { keyValue: data.F_Id },
                    success: function () { obj.del(); }
                });
            }
            else if (obj.event === 'edit') {
                if (!canEntry) { common.modalMsg("没有修改成绩的权限", "warning"); return false; }
                openForm("修改成绩", "/InstructionalManagement/Scores/Form?keyValue=" + data.F_Id, "700px", "620px");
            }
            else if (obj.event === 'audit') {
                if (!canAudit) { common.modalMsg("没有审核权限", "warning"); return false; }
                openForm("成绩审核", "/InstructionalManagement/Scores/AuditForm?keyValue=" + data.F_Id, "620px", "560px");
            }
            else if (obj.event === 'details') {
                common.modalOpen({ title: "成绩详情", url: "/InstructionalManagement/Scores/Details?keyValue=" + data.F_Id, width: "660px", height: "620px", btn: [] });
            }
            return false;
        });
    });
</script>
