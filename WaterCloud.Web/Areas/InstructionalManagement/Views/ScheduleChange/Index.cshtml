@{
    ViewBag.Title = "调课申请";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'table', 'common', 'commonTable'], function () {
        var $ = layui.jquery,
            form = layui.form,
            table = layui.table,
            common = layui.common,
            commonTable = layui.commonTable;

        wcLoading.close();
        var WEEK = ['', '周一', '周二', '周三', '周四', '周五', '周六', '周日'];
        function fmtTime(d) {
            return WEEK[d.F_NewWeekDay] + ' 第' + d.F_NewSection + '节' + (d.F_NewClassroomName ? ' · ' + d.F_NewClassroomName : '');
        }

        commonTable.rendertable({
            elem: '#currentTableId',
            id: 'currentTableId',
            url: '/InstructionalManagement/ScheduleChange/GetGridJson',
            cols: [[
                { type: 'checkbox', fixed: 'left' },
                { field: 'F_Semester', title: '学期', width: 120, sort: true },
                { field: 'F_ClassName', title: '班级', width: 130 },
                { field: 'F_CourseName', title: '课程', width: 120 },
                { field: 'F_TeacherName', title: '教师', width: 90 },
                { title: '原时间', width: 120, templet: function (d) { return WEEK[d.F_OldWeekDay] + ' 第' + d.F_OldSection + '节'; } },
                { title: '调整为', width: 170, templet: fmtTime },
                { field: 'F_Reason', title: '调课原因', minWidth: 140 },
                { field: 'F_ApplicantName', title: '申请人', width: 90 },
                { field: 'F_Status', title: '状态', width: 90, align: 'center', templet: '#statusTpl' },
                { field: 'F_AuditUserName', title: '审批人', width: 90 },
                { title: '操作', width: 150, toolbar: '#currentTableBar', align: 'center', fixed: 'right' }
            ]]
        });

        //监听搜索
        form.on('submit(data-search-btn)', function (data) {
            commonTable.reloadtable({
                elem: 'currentTableId',
                curr: 1,
                where: {
                    keyword: $('#txt_keyword').val(),
                    status: $('#F_Status').val()
                }
            });
            return false;
        });

        //行点击事件监听，控制按钮显示
        var oneList = ["NF-audit"];//选择1条显示
        var moreList = ["NF-delete"];//选中多条显示
        commonTable.tableRowClick("checkbox", "currentTableFilter", "currentTableId", oneList, moreList);

        //工具栏事件
        table.on('toolbar(currentTableFilter)', function (obj) {
            var checkStatus = table.checkStatus('currentTableId');
            if (obj.event === 'add') {
                common.modalOpen({
                    title: '申请调课',
                    url: '/InstructionalManagement/ScheduleChange/Form',
                    width: '520px',
                    height: '560px'
                });
            }
            else if (obj.event === 'delete') {
                if (checkStatus.data.length == 0) {
                    common.modalMsg('请选择需要删除的数据', 'warning');
                    return false;
                }
                var ids = [];
                for (var i = 0; i < checkStatus.data.length; i++) {
                    if (checkStatus.data[i].F_Status === 1) {
                        common.modalMsg('已通过的申请不允许删除', 'warning');
                        return false;
                    }
                    ids.push(checkStatus.data[i].F_Id);
                }
                common.deleteForm({
                    url: '/InstructionalManagement/ScheduleChange/DeleteForm',
                    param: { keyValue: ids.join(',') },
                    success: function () {
                        commonTable.reloadtable({ elem: 'currentTableId' });
                    }
                });
            }
        });

        //行操作事件
        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            if (obj.event === 'audit') {
                if (data.F_Status !== 0) {
                    common.modalMsg('该申请已审批', 'warning');
                    return false;
                }
                common.modalOpen({
                    title: '调课审批',
                    url: '/InstructionalManagement/ScheduleChange/AuditForm?keyValue=' + data.F_Id,
                    width: '520px',
                    height: '600px'
                });
            }
            else if (obj.event === 'delete') {
                if (data.F_Status === 1) {
                    common.modalMsg('已通过的申请不允许删除', 'warning');
                    return false;
                }
                common.deleteForm({
                    url: '/InstructionalManagement/ScheduleChange/DeleteForm',
                    param: { keyValue: data.F_Id },
                    success: function () {
                        commonTable.reloadtable({ elem: 'currentTableId' });
                    }
                });
            }
        });
    });
</script>

<div class="layuimini-container">
    <div class="layuimini-main">
        <fieldset class="table-search-fieldset">
            <legend>搜索信息</legend>
            <div style="margin: 10px 10px 10px 10px">
                <form class="layui-form layui-form-pane">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">关键字:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="txt_keyword" name="txt_keyword" autocomplete="off" class="layui-input" placeholder="班级/课程/教师">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">状态:</label>
                            <div class="layui-input-inline">
                                <select id="F_Status" name="F_Status">
                                    <option value="">全部</option>
                                    <option value="0">待审批</option>
                                    <option value="1">已通过</option>
                                    <option value="2">已拒绝</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>
        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container">
                <button class="layui-btn layui-btn-sm" lay-event="add" id="NF-add" name="NF-add" authorize><i class="layui-icon">&#xe654;</i>申请调课</button>
                <button class="layui-btn layui-btn-sm layui-btn-danger" lay-event="delete" id="NF-delete" name="NF-delete" authorize><i class="layui-icon">&#xe640;</i>删除</button>
            </div>
        </script>
        <script type="text/html" id="currentTableBar">
            <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="audit" id="NF-audit" authorize><i class="layui-icon">&#xe6b2;</i>审批</a>
            <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="delete" id="NF-delete" authorize><i class="layui-icon">&#xe640;</i>删除</a>
        </script>
        <script type="text/html" id="statusTpl">
            {{# if(d.F_Status === 1){ }}
            <span class="layui-badge layui-bg-green">已通过</span>
            {{# } else if(d.F_Status === 2){ }}
            <span class="layui-badge layui-bg-red">已拒绝</span>
            {{# } else { }}
            <span class="layui-badge layui-bg-orange">待审批</span>
            {{# } }}
        </script>
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
    </div>
</div>
