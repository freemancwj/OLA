@{
    ViewBag.Title = "选课名单";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'table', 'common', 'commonTable', 'optimizeSelectOption'], function () {
        var $ = layui.jquery,
            form = layui.form,
            table = layui.table,
            common = layui.common,
            commonTable = layui.commonTable;

        wcLoading.close();

        $("#F_RoundId").bindSelect({
            url: "/InstructionalManagement/ElectiveRecord/GetRoundListJson",
            id: "F_Id",
            text: "F_Name",
            search: true
        });
        //批次联动课程下拉
        form.on('select(F_RoundId)', function (data) {
            var sel = $('#F_ElectiveCourseId');
            sel.html('<option value="">全部课程</option>');
            if (data.value) {
                common.ajax({
                    url: '/InstructionalManagement/ElectiveRecord/GetCourseListJson',
                    data: { roundId: data.value },
                    async: false,
                    success: function (list) {
                        var html = '<option value="">全部课程</option>';
                        $.each(list, function (i, c) {
                            html += '<option value="' + c.F_Id + '">' + c.F_CourseName + '（' + (c.F_TeacherName || '') + '）</option>';
                        });
                        sel.html(html);
                    }
                });
            }
            form.render('select');
        });

        commonTable.rendertable({
            elem: '#currentTableId',
            id: 'currentTableId',
            url: '/InstructionalManagement/ElectiveRecord/GetGridJson',
            cols: [[
                { type: 'checkbox', fixed: 'left' },
                { field: 'F_RoundName', title: '批次', width: 130 },
                { field: 'F_CourseName', title: '课程', width: 140, sort: true },
                { field: 'F_TeacherName', title: '授课教师', width: 100 },
                { field: 'F_StudentName', title: '学生', width: 100, sort: true },
                { field: 'F_Account', title: '学号', width: 110, sort: true },
                { field: 'F_ClassName', title: '班级', width: 130 },
                {
                    field: 'F_SelectTime', title: '选课时间', width: 160, sort: true,
                    templet: function (d) { return d.F_SelectTime ? String(d.F_SelectTime).replace(/\//g, '-').substring(0, 16) : ''; }
                },
                { title: '操作', width: 100, toolbar: '#currentTableBar', align: 'center', fixed: 'right' }
            ]]
        });

        //监听搜索
        form.on('submit(data-search-btn)', function (data) {
            commonTable.reloadtable({
                elem: 'currentTableId',
                curr: 1,
                where: {
                    roundId: $('#F_RoundId').val(),
                    electiveCourseId: $('#F_ElectiveCourseId').val(),
                    keyword: $('#txt_keyword').val()
                }
            });
            return false;
        });

        //行点击事件监听，控制按钮显示
        var oneList = [];
        var moreList = ["NF-delete"];//选中多条显示
        commonTable.tableRowClick("checkbox", "currentTableFilter", "currentTableId", oneList, moreList);

        //工具栏事件
        table.on('toolbar(currentTableFilter)', function (obj) {
            var checkStatus = table.checkStatus('currentTableId');
            if (obj.event === 'delete') {
                if (checkStatus.data.length == 0) {
                    common.modalMsg('请选择需要移除的数据', 'warning');
                    return false;
                }
                var ids = [];
                for (var i = 0; i < checkStatus.data.length; i++) {
                    ids.push(checkStatus.data[i].F_Id);
                }
                common.deleteForm({
                    url: '/InstructionalManagement/ElectiveRecord/DeleteForm',
                    param: { keyValue: ids.join(',') },
                    success: function () {
                        commonTable.reloadtable({ elem: 'currentTableId' });
                    }
                });
            }
        });

        //行操作事件
        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            if (obj.event === 'delete') {
                common.deleteForm({
                    url: '/InstructionalManagement/ElectiveRecord/DeleteForm',
                    param: { keyValue: data.F_Id },
                    success: function () {
                        commonTable.reloadtable({ elem: 'currentTableId' });
                    }
                });
            }
        });
    });
</script>

<div class="layuimini-container">
    <div class="layuimini-main">
        <fieldset class="table-search-fieldset">
            <legend>搜索信息</legend>
            <div style="margin: 10px 10px 10px 10px">
                <form class="layui-form layui-form-pane">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">批次:</label>
                            <div class="layui-input-inline">
                                <select id="F_RoundId" name="F_RoundId" lay-filter="F_RoundId" lay-search>
                                    <option value="">全部批次</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">课程:</label>
                            <div class="layui-input-inline">
                                <select id="F_ElectiveCourseId" name="F_ElectiveCourseId" lay-search>
                                    <option value="">全部课程</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">关键字:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="txt_keyword" name="txt_keyword" autocomplete="off" class="layui-input" placeholder="学生/学号">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>
        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container">
                <button class="layui-btn layui-btn-sm layui-btn-danger" lay-event="delete" id="NF-delete" name="NF-delete" authorize><i class="layui-icon">&#xe640;</i>移除选课</button>
            </div>
        </script>
        <script type="text/html" id="currentTableBar">
            <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="delete" id="NF-delete" authorize><i class="layui-icon">&#xe640;</i>移除</a>
        </script>
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
    </div>
</div>
