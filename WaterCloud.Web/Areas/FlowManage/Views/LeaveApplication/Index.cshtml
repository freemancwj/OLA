@{
    ViewBag.Title = "请假管理";
    Layout = "~/Views/Shared/_Index.cshtml";
}
<div class="layuimini-container">
    <div class="layuimini-main">
        <fieldset class="table-search-fieldset layui-hide" id="searchField">
            <div>
                <form class="layui-form layui-form-pane">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">关键字:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="txt_keyword" name="txt_keyword" autocomplete="off" class="layui-input" placeholder="申请人/请假原因">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">请假类型:</label>
                            <div class="layui-input-inline">
                                <select id="txt_leaveType" name="txt_leaveType">
                                    <option value="">全部</option>
                                    <option value="1">年假</option>
                                    <option value="2">病假</option>
                                    <option value="3">事假</option>
                                    <option value="4">婚假</option>
                                    <option value="5">产假</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">审批状态:</label>
                            <div class="layui-input-inline">
                                <select id="txt_status" name="txt_status">
                                    <option value="">全部</option>
                                    <option value="0">审批中</option>
                                    <option value="1">已通过</option>
                                    <option value="2">未通过</option>
                                    <option value="3">已驳回</option>
                                    <option value="4">已撤回</option>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn"><i class="layui-icon">&#xe615;</i> 搜 索</button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>
        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container" id="toolbar">
                <button id="NF-add" name="NF-add" authorize class="layui-btn layui-btn-sm" lay-event="add"><i class="layui-icon">&#xe654;</i>申请请假</button>
            </div>
        </script>
        <script type="text/html" id="currentTableBar">
            <a id="NF-edit" authorize class="layui-btn layui-btn-xs layui-btn-warm" lay-event="edit">修改</a>
            <a id="NF-cancle" authorize class="layui-btn layui-btn-xs layui-btn-danger" lay-event="cancle">撤回</a>
            <a id="NF-details" authorize class="layui-btn layui-btn-xs layui-btn-normal" lay-event="details">进度</a>
            <a id="NF-delete" authorize class="layui-btn layui-btn-xs layui-btn-danger" lay-event="delete">删除</a>
        </script>
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>
    </div>
</div>
<script>
    layui.use(['jquery', 'form', 'table', 'common', 'commonTable', 'optimizeSelectOption'], function () {
        var form = layui.form,
            table = layui.table,
            commonTable = layui.commonTable,
            common = layui.common;
        //权限控制(js是值传递)
        currentTableBar.innerHTML = common.authorizeButtonNew(currentTableBar.innerHTML);
        toolbarDemo.innerHTML = common.authorizeButtonNew(toolbarDemo.innerHTML);
        commonTable.rendertable({
            elem: '#currentTableId',
            id: 'currentTableId',
            url: '/FlowManage/LeaveApplication/GetGridJson',
            cols: [[
                { type: "radio", width: 50, fixed: 'left' },
                {
                    field: 'F_Status', title: '审批状态', width: 100, filter: true,
                    templet: function (d) {
                        switch (d.F_Status) {
                            case 0: return "<span class='layui-badge layui-bg-blue'>审批中</span>";
                            case 1: return "<span class='layui-badge layui-bg-green'>已通过</span>";
                            case 2: return "<span class='layui-badge'>未通过</span>";
                            case 3: return "<span class='layui-badge layui-bg-orange'>已驳回</span>";
                            case 4: return "<span class='layui-badge layui-bg-gray'>已撤回</span>";
                            default: return '';
                        }
                    }
                },
                {
                    field: 'F_ApplicantType', title: '申请类型', width: 100, filter: true,
                    templet: function (d) {
                        return d.F_ApplicantType == 2 ? '学生请假' : '教师请假';
                    }
                },
                { field: 'F_ApplicantName', title: '申请人', width: 100, filter: true },
                {
                    field: 'F_LeaveType', title: '请假类型', width: 100, filter: true,
                    templet: function (d) {
                        switch (d.F_LeaveType) {
                            case 1: return '年假';
                            case 2: return '病假';
                            case 3: return '事假';
                            case 4: return '婚假';
                            case 5: return '产假';
                            default: return '';
                        }
                    }
                },
                {
                    field: 'F_StartTime', title: '开始时间', width: 150, sort: true,
                    templet: function (d) {
                        return d.F_StartTime ? new Date(d.F_StartTime).Format("yyyy-MM-dd hh:mm") : '';
                    }
                },
                {
                    field: 'F_EndTime', title: '结束时间', width: 150, sort: true,
                    templet: function (d) {
                        return d.F_EndTime ? new Date(d.F_EndTime).Format("yyyy-MM-dd hh:mm") : '';
                    }
                },
                { field: 'F_LeaveDays', title: '天数', width: 80 },
                { field: 'F_Reason', title: '请假原因', minWidth: 150 },
                { field: 'F_CurrentApprover', title: '当前审批人', width: 120 },
                {
                    field: 'F_CreatorTime', title: '申请时间', width: 150, sort: true,
                    templet: function (d) {
                        return d.F_CreatorTime ? new Date(d.F_CreatorTime).Format("yyyy-MM-dd hh:mm") : '';
                    }
                },
                { title: '操作', width: 200, toolbar: '#currentTableBar', align: "center", fixed: 'right' }
            ]]
        });
        // 监听搜索操作
        form.on('submit(data-search-btn)', function (data) {
            commonTable.reloadtable({
                elem: 'currentTableId',
                curr: 1,
                where: { keyword: data.field.txt_keyword, leaveType: data.field.txt_leaveType, status: data.field.txt_status }
            });
            return false;
        });
        wcLoading.close();
        //toolbar监听事件
        table.on('toolbar(currentTableFilter)', function (obj) {
            if (obj.event === 'add') {
                common.modalOpen({
                    title: "申请请假",
                    url: "/FlowManage/LeaveApplication/Form",
                    width: "650px",
                    height: "550px",
                });
            }
            else if (obj.event === 'TABLE_SEARCH') {
                var _that = $("#searchField");
                if (_that.hasClass("layui-hide")) {
                    _that.removeClass('layui-hide');
                } else {
                    _that.addClass('layui-hide');
                }
                table.resize();
            }
            return false;
        });
        //toolrow监听事件
        table.on('tool(currentTableFilter)', function (obj) {
            if (obj.event === 'edit') {
                if (obj.data.F_Status != 3 && obj.data.F_Status != 4) {
                    common.modalMsg("仅被驳回或已撤回的申请可以修改", "warning");
                    return false;
                }
                common.modalOpen({
                    title: "修改请假申请",
                    url: "/FlowManage/LeaveApplication/Form?keyValue=" + obj.data.F_Id,
                    width: "650px",
                    height: "550px",
                });
            }
            else if (obj.event === 'cancle') {
                if (obj.data.F_Status != 0) {
                    common.modalMsg("仅审批中的申请可以撤回", "warning");
                    return false;
                }
                common.submitPost({
                    prompt: "注：您确定要撤回该请假申请吗？",
                    url: "/FlowManage/LeaveApplication/CancleForm",
                    param: { keyValue: obj.data.F_Id },
                    success: function () {
                        common.reload('data-search-btn');
                    }
                });
            }
            else if (obj.event === 'delete') {
                if (obj.data.F_Status == 0) {
                    common.modalMsg("审批中的申请不可删除，请先撤回", "warning");
                    return false;
                }
                common.deleteForm({
                    url: "/FlowManage/LeaveApplication/DeleteForm",
                    param: { keyValue: obj.data.F_Id },
                    success: function () {
                        common.reload('data-search-btn');
                    }
                });
            }
            else if (obj.event === 'details') {
                if (!obj.data.F_FlowInstanceId) {
                    common.modalMsg("该申请尚未发起流程", "warning");
                    return false;
                }
                common.modalOpen({
                    title: "查看审批进度",
                    url: "/FlowManage/Flowinstance/Details?keyValue=" + obj.data.F_FlowInstanceId,
                    width: "750px",
                    height: "600px",
                    btn: []
                });
            }
            return false;
        });
    });
</script>
