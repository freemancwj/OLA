@{
    ViewBag.Title = "请假申请";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<div class="layuimini-container">
    <div class="layuimini-main">
        <form class="layui-form layui-form-pane" lay-filter="formLeave">
            <div class="layui-form-item">
                <label class="layui-form-label">请假类型</label>
                <div class="layui-input-block">
                    <select name="F_LeaveType" lay-verify="required">
                        <option value="1">年假</option>
                        <option value="2">病假</option>
                        <option value="3">事假</option>
                        <option value="4">婚假</option>
                        <option value="5">产假</option>
                    </select>
                </div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label">开始时间</label>
                <div class="layui-input-block">
                    <input type="text" name="F_StartTime" lay-verify="required" placeholder="请选择开始时间" autocomplete="off" class="layui-input" onclick="layui.laydate.render({ elem: this, type: 'datetime' })">
                </div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label">结束时间</label>
                <div class="layui-input-block">
                    <input type="text" name="F_EndTime" lay-verify="required" placeholder="请选择结束时间" autocomplete="off" class="layui-input" onclick="layui.laydate.render({ elem: this, type: 'datetime' })">
                </div>
            </div>
            <div class="layui-form-item layui-form-text">
                <label class="layui-form-label">请假原因</label>
                <div class="layui-input-block">
                    <textarea name="F_Reason" placeholder="请输入请假原因" class="layui-textarea"></textarea>
                </div>
            </div>
            <div class="layui-form-item">
                <div class="layui-input-block">
                    <button class="layui-btn" lay-submit lay-filter="submit">立即提交</button>
                </div>
            </div>
        </form>
    </div>
</div>
<script>
    layui.use(['form', 'jquery', 'common'], function () {
        var form = layui.form,
            $ = layui.jquery,
            common = layui.common;

        // 监听提交
        form.on('submit(submit)', function (data) {
            var field = data.field;
            // 计算请假天数
            var startTime = new Date(field.F_StartTime);
            var endTime = new Date(field.F_EndTime);
            field.F_LeaveDays = (endTime - startTime) / (1000 * 60 * 60 * 24);
            
            common.submitForm({
                url: '/FlowManage/LeaveApplication/SubmitForm',
                data: field,
                success: function (data) {
                    common.reloadIframe("/FlowManage/LeaveApplication/Index", 'data-search-btn');
                }
            })
            return false;
        });
    });
</script>