@{
    ViewBag.Title = "请假申请";
    Layout = "~/Views/Shared/_Form.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'laydate', 'common'], function () {
        var form = layui.form,
            $ = layui.jquery,
            laydate = layui.laydate,
            common = layui.common;
        var keyValue = $.request("keyValue");

        laydate.render({ elem: '#F_StartTime', type: 'datetime', format: 'yyyy-MM-dd HH:mm', done: calcDays });
        laydate.render({ elem: '#F_EndTime', type: 'datetime', format: 'yyyy-MM-dd HH:mm', done: calcDays });

        function calcDays() {
            var start = $('#F_StartTime').val();
            var end = $('#F_EndTime').val();
            if (!start || !end) {
                return;
            }
            var startTime = new Date(start.replace(/-/g, '/'));
            var endTime = new Date(end.replace(/-/g, '/'));
            var days = (endTime - startTime) / (1000 * 60 * 60 * 24);
            if (days <= 0) {
                $('#F_LeaveDays').val('');
                common.modalMsg('结束时间必须大于开始时间', 'warning');
                return;
            }
            //保留一位小数，半天起算
            $('#F_LeaveDays').val(Math.round(days * 10) / 10);
        }

        $(function () {
            if (!!keyValue) {
                common.ajax({
                    url: '/FlowManage/LeaveApplication/GetFormJson',
                    data: { keyValue: keyValue },
                    async: false,
                    success: function (data) {
                        $('#F_LeaveType').val(String(data.F_LeaveType));
                        if (!!data.F_StartTime) {
                            $('#F_StartTime').val(new Date(data.F_StartTime).Format("yyyy-MM-dd hh:mm"));
                        }
                        if (!!data.F_EndTime) {
                            $('#F_EndTime').val(new Date(data.F_EndTime).Format("yyyy-MM-dd hh:mm"));
                        }
                        $('#F_LeaveDays').val(data.F_LeaveDays);
                        $('#F_Reason').val(data.F_Reason);
                        form.render();
                    }
                });
            }
        });
        wcLoading.close();

        //监听提交
        form.on('submit(saveBtn)', function (data) {
            var field = data.field;
            if (!field.F_LeaveDays || parseFloat(field.F_LeaveDays) <= 0) {
                common.modalMsg('请假天数必须大于0', 'warning');
                return false;
            }
            common.submitForm({
                url: '/FlowManage/LeaveApplication/SubmitForm?keyValue=' + (keyValue || ''),
                param: field,
                success: function () {
                    common.parentreload('data-search-btn');
                }
            });
            return false;
        });
    });
</script>

<body>
    <div class="layuimini-container">
        <div class="layuimini-main">
            <div class="layui-form layuimini-form" lay-filter="adminform">
                <div class="layui-form-item">
                    <label class="layui-form-label required">请假类型</label>
                    <div class="layui-input-block">
                        <select id="F_LeaveType" name="F_LeaveType" lay-verify="required">
                            <option value="">请选择请假类型</option>
                            <option value="1">年假</option>
                            <option value="2">病假</option>
                            <option value="3">事假</option>
                            <option value="4">婚假</option>
                            <option value="5">产假</option>
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <div class="layui-inline">
                        <label class="layui-form-label required">开始时间</label>
                        <div class="layui-input-inline">
                            <input type="text" id="F_StartTime" name="F_StartTime" lay-verify="required" placeholder="请选择开始时间" autocomplete="off" class="layui-input">
                        </div>
                    </div>
                    <div class="layui-inline">
                        <label class="layui-form-label required">结束时间</label>
                        <div class="layui-input-inline">
                            <input type="text" id="F_EndTime" name="F_EndTime" lay-verify="required" placeholder="请选择结束时间" autocomplete="off" class="layui-input">
                        </div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label required">请假天数</label>
                    <div class="layui-input-block">
                        <input type="text" id="F_LeaveDays" name="F_LeaveDays" lay-verify="required" readonly placeholder="选择起止时间后自动计算" autocomplete="off" class="layui-input layui-disabled">
                    </div>
                </div>
                <div class="layui-form-item layui-form-text">
                    <label class="layui-form-label required">请假原因</label>
                    <div class="layui-input-block">
                        <textarea id="F_Reason" name="F_Reason" lay-verify="required" maxlength="500" placeholder="请输入请假原因" class="layui-textarea"></textarea>
                    </div>
                </div>
                <div class="layui-form-item layui-hide">
                    <button class="layui-btn site-demo-active" lay-submit id="submit" lay-filter="saveBtn">确认保存</button>
                </div>
            </div>
        </div>
    </div>
</body>
